{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rafaelia.local/schemas/rafaelia-foundation-manifest.v1.schema.json",
  "title": "RAFAELIA Foundation Manifest V1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "version",
    "project",
    "governance",
    "runtime",
    "inputs",
    "profiles"
  ],
  "properties": {
    "schema": {
      "const": "rafaelia.foundation.manifest/v1"
    },
    "version": {
      "const": "1.0.0"
    },
    "project": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "id",
        "kind",
        "repository"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9._-]{2,127}$"
        },
        "kind": {
          "type": "string"
        },
        "repository": {
          "type": "string"
        }
      }
    },
    "governance": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "claim_allowed",
        "network_required",
        "destructive_operations",
        "remote_ci_substituted",
        "token_vazio_is_valid"
      ],
      "properties": {
        "claim_allowed": {
          "const": false
        },
        "network_required": {
          "const": false
        },
        "destructive_operations": {
          "const": false
        },
        "remote_ci_substituted": {
          "const": false
        },
        "token_vazio_is_valid": {
          "const": true
        }
      }
    },
    "runtime": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "class",
        "output_directory",
        "append_only_receipts"
      ],
      "properties": {
        "class": {
          "const": "ANDROID_TERMUX_LOCAL"
        },
        "output_directory": {
          "const": "COMPILA"
        },
        "append_only_receipts": {
          "const": true
        }
      }
    },
    "inputs": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "source",
        "required_paths"
      ],
      "properties": {
        "source": {
          "type": [
            "string",
            "null"
          ]
        },
        "required_paths": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "profiles": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "object",
        "additionalProperties": true,
        "required": [
          "mode",
          "requires_source",
          "required_paths",
          "commands"
        ],
        "properties": {
          "mode": {
            "enum": [
              "DOCUMENTATION",
              "COMMANDS"
            ]
          },
          "requires_source": {
            "type": "boolean"
          },
          "required_paths": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "commands": {
            "type": "array",
            "items": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string"
              }
            }
          },
          "description": {
            "type": "string"
          }
        }
      }
    }
  }
}
