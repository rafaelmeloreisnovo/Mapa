{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rafaelia.local/schemas/proof-custody-receipt.schema.json",
  "title": "RAFAELIA Proof Custody Receipt",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "receipt_id", "observed_at", "source", "artifacts", "verification", "governance", "decision"],
  "properties": {
    "schema": {"const": "rafaelia.proof-custody-receipt.v1"},
    "receipt_id": {"type": "string", "minLength": 1},
    "observed_at": {"type": "string", "format": "date-time"},
    "observer_mode": {"type": "string"},
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "default_branch", "commit_sha", "commit_time", "visibility"],
      "properties": {
        "repository": {"type": "string", "minLength": 1},
        "default_branch": {"type": "string", "minLength": 1},
        "commit_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "commit_time": {"type": "string", "format": "date-time"},
        "visibility": {"enum": ["public", "private", "internal"]}
      }
    },
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "blob_sha", "role"],
        "properties": {
          "path": {"type": "string", "minLength": 1},
          "blob_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
          "role": {"type": "string", "minLength": 1},
          "declared_properties": {"type": "object"}
        }
      }
    },
    "verification": {
      "type": "object",
      "additionalProperties": false,
      "required": ["hash_bound", "build", "independent_checker"],
      "properties": {
        "hash_bound": {"type": "boolean"},
        "build": {"$ref": "#/$defs/gate"},
        "independent_checker": {"$ref": "#/$defs/gate"}
      }
    },
    "governance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "pull_requests_observed",
        "reviews_observed",
        "combined_status_checks",
        "reviewer_identity",
        "reviewed_commit_sha",
        "approval_receipt",
        "merge_commit_sha",
        "independent_review_approved",
        "merged_on_protected_edge",
        "required_checks_pass"
      ],
      "properties": {
        "pull_requests_observed": {"type": "integer", "minimum": 0},
        "reviews_observed": {"type": "integer", "minimum": 0},
        "combined_status_checks": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "reviewer_identity": {"type": ["string", "null"], "minLength": 1},
        "reviewed_commit_sha": {"anyOf": [{"type": "null"}, {"type": "string", "pattern": "^[0-9a-f]{40}$"}]},
        "approval_receipt": {"type": ["string", "null"], "minLength": 1},
        "merge_commit_sha": {"anyOf": [{"type": "null"}, {"type": "string", "pattern": "^[0-9a-f]{40}$"}]},
        "independent_review_approved": {"type": "boolean"},
        "merged_on_protected_edge": {"type": "boolean"},
        "required_checks_pass": {"type": "boolean"}
      }
    },
    "decision": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "classification",
        "token_valid",
        "claim_allowed",
        "receipt_digest_present",
        "receipt_payload_sha256",
        "blocking_token_vazio"
      ],
      "properties": {
        "classification": {"type": "string", "minLength": 1},
        "token_valid": {"type": "boolean"},
        "claim_allowed": {"type": "boolean"},
        "receipt_digest_present": {"type": "boolean"},
        "receipt_payload_sha256": {"anyOf": [{"type": "null"}, {"type": "string", "pattern": "^[0-9a-f]{64}$"}]},
        "blocking_token_vazio": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "notes": {"type": "array", "items": {"type": "string"}}
      }
    }
  },
  "$defs": {
    "gate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "executed_in_this_audit", "pass", "toolchain", "commands", "receipt"],
      "properties": {
        "status": {"type": "string", "minLength": 1},
        "executed_in_this_audit": {"type": "boolean"},
        "pass": {"type": "boolean"},
        "toolchain": {"type": ["string", "null"], "minLength": 1},
        "commands": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "receipt": {"type": ["string", "null"], "minLength": 1}
      }
    }
  }
}
