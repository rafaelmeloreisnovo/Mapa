{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rafaelia.invalid/schemas/repository-gap-map.schema.json",
  "title": "RAFAELIA Repository Gap Map",
  "type": "object",
  "required": [
    "schema",
    "generated_at",
    "roots",
    "configuration",
    "root_stats",
    "summary",
    "artifacts"
  ],
  "properties": {
    "schema": {
      "const": "rafaelia.repository-gap-map/v1"
    },
    "generated_at": {
      "type": "string",
      "format": "date-time"
    },
    "roots": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["name", "path"],
        "properties": {
          "name": {"type": "string", "minLength": 1},
          "path": {"type": "string", "minLength": 1}
        },
        "additionalProperties": false
      }
    },
    "configuration": {
      "type": "object",
      "required": ["excludes", "content_limit", "max_hash_bytes", "fail_on"],
      "properties": {
        "excludes": {
          "type": "array",
          "items": {"type": "string"}
        },
        "content_limit": {"type": "integer", "minimum": 1},
        "max_hash_bytes": {"type": "integer", "minimum": 0},
        "fail_on": {
          "enum": ["none", "markers", "asm", "binary", "hash", "any"]
        }
      },
      "additionalProperties": false
    },
    "root_stats": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": ["files", "bytes", "gaps"],
        "properties": {
          "files": {"type": "integer", "minimum": 0},
          "bytes": {"type": "integer", "minimum": 0},
          "gaps": {"type": "integer", "minimum": 0}
        },
        "additionalProperties": false
      }
    },
    "summary": {
      "type": "object",
      "required": [
        "artifacts",
        "gap_instances",
        "files_with_gaps",
        "asm_sources",
        "asm_unreferenced",
        "elf",
        "dex",
        "apk",
        "documents_incomplete",
        "binary_provenance_missing"
      ],
      "additionalProperties": {
        "type": "integer",
        "minimum": 0
      }
    },
    "artifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "artifact_id",
          "root",
          "path",
          "size_bytes",
          "kind",
          "language",
          "magic",
          "sha256",
          "hash_status",
          "unresolved_markers",
          "spdx_present",
          "build_referenced",
          "referenced_by",
          "provenance_sidecars",
          "gaps"
        ],
        "properties": {
          "artifact_id": {
            "type": "string",
            "pattern": "^[0-9a-f]{24}$"
          },
          "root": {"type": "string", "minLength": 1},
          "path": {"type": "string", "minLength": 1},
          "size_bytes": {"type": "integer", "minimum": -1},
          "kind": {"type": "string", "minLength": 1},
          "language": {"type": ["string", "null"]},
          "magic": {"type": ["string", "null"]},
          "sha256": {
            "type": ["string", "null"],
            "pattern": "^[0-9a-f]{64}$"
          },
          "hash_status": {"type": "string", "minLength": 1},
          "unresolved_markers": {
            "type": "array",
            "uniqueItems": true,
            "items": {"type": "string"}
          },
          "spdx_present": {"type": ["boolean", "null"]},
          "build_referenced": {"type": ["boolean", "null"]},
          "referenced_by": {
            "type": "array",
            "uniqueItems": true,
            "items": {"type": "string"}
          },
          "provenance_sidecars": {
            "type": "array",
            "uniqueItems": true,
            "items": {"type": "string"}
          },
          "gaps": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "enum": [
                "UNRESOLVED_MARKERS",
                "ASM_NOT_REFERENCED_BY_BUILD",
                "BINARY_PROVENANCE_MISSING",
                "HASH_INCOMPLETE",
                "DOCUMENT_INCOMPLETE"
              ]
            }
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
