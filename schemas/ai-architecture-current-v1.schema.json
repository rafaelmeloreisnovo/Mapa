{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rafaelia.local/schemas/ai-architecture-current-v1.schema.json",
  "title": "RAFAELIA AI Architecture Manifold Current V1",
  "type": "object",
  "required": [
    "schema",
    "version",
    "observed_at",
    "state",
    "claim_allowed",
    "read_policy",
    "source_bindings",
    "authorities",
    "nodes",
    "edges",
    "atlas_areas",
    "agent_roles",
    "session_packets",
    "gaps",
    "ai_entry_protocol",
    "R3"
  ],
  "properties": {
    "schema": {
      "const": "rafaelia.ai-architecture-manifold-current.v1"
    },
    "version": {
      "const": "1.0.0"
    },
    "claim_allowed": {
      "const": false
    },
    "read_policy": {
      "type": "object",
      "required": [
        "roots_max",
        "depth_default",
        "roots"
      ],
      "properties": {
        "roots_max": {
          "const": 3
        },
        "depth_default": {
          "const": 1
        },
        "roots": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3
        }
      }
    },
    "nodes": {
      "type": "array",
      "minItems": 8
    },
    "edges": {
      "type": "array",
      "minItems": 8
    },
    "atlas_areas": {
      "type": "array",
      "minItems": 12
    },
    "agent_roles": {
      "type": "array",
      "minItems": 11
    },
    "session_packets": {
      "type": "array",
      "minItems": 8
    },
    "gaps": {
      "type": "array",
      "minItems": 1
    }
  },
  "additionalProperties": true
}
