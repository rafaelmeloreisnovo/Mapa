{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rafaelia.example/schemas/json-totality-invariant-audit.v1.schema.json",
  "title": "RAFAELIA JSON Totality Invariant Audit V1",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "schema",
    "state",
    "claim_allowed",
    "contract",
    "files_scanned",
    "records_scanned",
    "governed_records",
    "governed_pass",
    "governed_gap",
    "conservation_rate",
    "dimension_coverage",
    "profile_counts",
    "gap_counts",
    "f_ok",
    "f_gap",
    "f_next"
  ],
  "properties": {
    "schema": {"const": "rafaelia.json-totality-invariant-audit/v1"},
    "state": {"enum": ["PASS", "GAP", "TOKEN_VAZIO_NO_GOVERNED_RECORDS"]},
    "claim_allowed": {"const": false},
    "contract": {
      "const": "representation_may_evolve_but_identity_provenance_lineage_epistemic_boundary_must_remain_traceable"
    },
    "files_scanned": {"type": "integer", "minimum": 0},
    "records_scanned": {"type": "integer", "minimum": 0},
    "governed_records": {"type": "integer", "minimum": 0},
    "governed_pass": {"type": "integer", "minimum": 0},
    "governed_gap": {"type": "integer", "minimum": 0},
    "conservation_rate": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
    "dimension_coverage": {
      "type": "object",
      "required": ["identity", "provenance", "lineage", "epistemic_boundary", "claim_gate"],
      "additionalProperties": false,
      "properties": {
        "identity": {"$ref": "#/$defs/coverage"},
        "provenance": {"$ref": "#/$defs/coverage"},
        "lineage": {"$ref": "#/$defs/coverage"},
        "epistemic_boundary": {"$ref": "#/$defs/coverage"},
        "claim_gate": {"$ref": "#/$defs/coverage"}
      }
    },
    "profile_counts": {"type": "object", "additionalProperties": {"type": "integer", "minimum": 0}},
    "gap_counts": {"type": "object", "additionalProperties": {"type": "integer", "minimum": 0}},
    "f_ok": {"type": "array", "items": {"type": "string"}},
    "f_gap": {"type": "array", "items": {"type": "string"}},
    "f_next": {"type": "string", "minLength": 1},
    "canonical_report_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
  },
  "$defs": {
    "coverage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ok", "total", "coverage"],
      "properties": {
        "ok": {"type": "integer", "minimum": 0},
        "total": {"type": "integer", "minimum": 0},
        "coverage": {"type": ["number", "null"], "minimum": 0, "maximum": 1}
      }
    }
  }
}
