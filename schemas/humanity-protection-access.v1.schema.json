{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/rafaelmeloreisnovo/Mapa/schemas/humanity-protection-access.v1.schema.json",
  "title": "RAFAELIA Humanity Protection and Access Policy V1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "status",
    "adopted_at",
    "authorial_intent",
    "claim_allowed",
    "invariants",
    "protection",
    "access",
    "blocked_by_default",
    "release_gate",
    "sources"
  ],
  "properties": {
    "schema_version": {"const": "rafaelia.humanity-protection-access/v1"},
    "status": {"const": "DRAFT_IMPLEMENTED_LEGAL_REVIEW_REQUIRED"},
    "adopted_at": {"type": "string", "minLength": 10},
    "authorial_intent": {"type": "string", "minLength": 20},
    "claim_allowed": {"const": false},
    "invariants": {"type": "array", "minItems": 5, "items": {"type": "string", "minLength": 5}},
    "protection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["preserve_human_authorship","preserve_upstream_notices","preserve_provenance","forbid_false_authorship","nationality_neutral"],
      "properties": {
        "preserve_human_authorship": {"const": true},
        "preserve_upstream_notices": {"const": true},
        "preserve_provenance": {"const": true},
        "forbid_false_authorship": {"const": true},
        "nationality_neutral": {"const": true}
      }
    },
    "access": {
      "type": "object",
      "additionalProperties": false,
      "required": ["blanket_relicense","existing_grants_preserved","commercial_use_policy","software_license_policy","documentation_license_candidate","research_license_candidate","dataset_policy"],
      "properties": {
        "blanket_relicense": {"const": false},
        "existing_grants_preserved": {"const": true},
        "commercial_use_policy": {"type": "string"},
        "software_license_policy": {"type": "string"},
        "documentation_license_candidate": {"type": "string"},
        "research_license_candidate": {"type": "string"},
        "dataset_policy": {"type": "string"}
      }
    },
    "blocked_by_default": {"type": "array", "minItems": 4, "uniqueItems": true, "items": {"type": "string"}},
    "release_gate": {"type": "array", "minItems": 8, "uniqueItems": true, "items": {"type": "string"}},
    "sources": {
      "type": "array",
      "minItems": 4,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id","locator","supports"],
        "properties": {
          "id": {"type": "string", "minLength": 3},
          "locator": {"type": "string", "pattern": "^https://"},
          "supports": {"type": "array", "minItems": 1, "items": {"type": "string"}}
        }
      }
    }
  }
}
