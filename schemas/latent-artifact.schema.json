{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rafaelia.example/schemas/latent-artifact.schema.json",
  "title": "RAFAELIA Latent Artifact Record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "latent_id",
    "title",
    "latent_type",
    "source_references",
    "domains",
    "summary",
    "epistemic_state",
    "evidence_ids",
    "falsifiers",
    "gaps",
    "next_gate",
    "destination",
    "privacy_class",
    "license_or_authorization",
    "claim_allowed"
  ],
  "properties": {
    "schema": {
      "const": "rafaelia.latent-artifact.v1"
    },
    "latent_id": {
      "type": "string",
      "pattern": "^LAT-[A-Z0-9][A-Z0-9._-]{2,63}$"
    },
    "title": {
      "type": "string",
      "minLength": 3,
      "maxLength": 240
    },
    "latent_type": {
      "enum": [
        "LAT-IMG",
        "LAT-TXT",
        "LAT-CODE",
        "LAT-MATH",
        "LAT-SCI",
        "LAT-GOV",
        "LAT-PAPER"
      ]
    },
    "source_references": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "system",
          "locator",
          "observation_state"
        ],
        "properties": {
          "system": {
            "enum": [
              "GITHUB",
              "GOOGLE_DRIVE",
              "SESSION",
              "LOCAL_RUNTIME",
              "PUBLIC_SOURCE"
            ]
          },
          "locator": {
            "type": "string",
            "minLength": 1
          },
          "commit": {
            "type": "string",
            "pattern": "^[0-9a-f]{40}$"
          },
          "blob": {
            "type": "string",
            "pattern": "^[0-9a-f]{40}$"
          },
          "content_hash": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              "blake3_256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              "md5": {
                "type": "string",
                "pattern": "^[0-9a-f]{32}$"
              }
            },
            "minProperties": 1
          },
          "observation_state": {
            "enum": [
              "VERIFIED_PRIMARY",
              "VERIFIED_LOCAL",
              "DECLARED_BY_AUTHOR",
              "RESOLVED_CONTRACTUAL_NOT_FETCHED",
              "TOKEN_VAZIO"
            ]
          }
        }
      }
    },
    "domains": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[A-Z0-9][A-Z0-9._-]{1,63}$"
      }
    },
    "summary": {
      "type": "string",
      "minLength": 10
    },
    "epistemic_state": {
      "enum": [
        "PASS",
        "VERIFIED_LOCAL",
        "IMPLEMENTED",
        "PARTIAL",
        "DRAFT",
        "TOKEN_VAZIO",
        "BLOCKED",
        "FAIL",
        "DISPUTED",
        "REJECTED"
      ]
    },
    "evidence_ids": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "falsifiers": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 3
      }
    },
    "gaps": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "token",
          "reason",
          "expected_artifact"
        ],
        "properties": {
          "token": {
            "type": "string",
            "pattern": "^TOKEN_VAZIO(?:_[A-Z0-9_]+)?$"
          },
          "reason": {
            "type": "string",
            "minLength": 5
          },
          "expected_artifact": {
            "type": "string",
            "minLength": 3
          }
        }
      }
    },
    "next_gate": {
      "type": "string",
      "minLength": 5
    },
    "destination": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 2
      }
    },
    "privacy_class": {
      "enum": [
        "PUBLIC",
        "AUTHORIZED_PRIVATE",
        "PRIVATE_RESTRICTED",
        "SENSITIVE_EXCLUDED"
      ]
    },
    "license_or_authorization": {
      "type": "string",
      "minLength": 1
    },
    "claim_allowed": {
      "type": "boolean"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "claim_allowed": {
            "const": true
          }
        },
        "required": [
          "claim_allowed"
        ]
      },
      "then": {
        "properties": {
          "epistemic_state": {
            "enum": [
              "PASS",
              "VERIFIED_LOCAL"
            ]
          },
          "evidence_ids": {
            "minItems": 1
          },
          "falsifiers": {
            "minItems": 1
          },
          "gaps": {
            "maxItems": 0
          },
          "privacy_class": {
            "enum": [
              "PUBLIC",
              "AUTHORIZED_PRIVATE"
            ]
          },
          "license_or_authorization": {
            "not": {
              "const": "TOKEN_VAZIO"
            }
          }
        }
      }
    }
  ]
}
