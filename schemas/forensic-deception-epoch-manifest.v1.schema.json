{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rafaelia.local/schemas/forensic-deception-epoch-manifest.v1.schema.json",
  "title": "RAFAELIA Forensic Deception Epoch Manifest V1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "manifest_id",
    "status",
    "claim_allowed",
    "context",
    "roots",
    "fingerprint",
    "deception",
    "custody",
    "limitations"
  ],
  "properties": {
    "schema_version": {"const": "forensic-deception-epoch-manifest.v1"},
    "manifest_id": {"type": "string", "minLength": 8, "maxLength": 160},
    "status": {
      "enum": ["DRAFT", "REFERENCE", "AUDIT", "VERIFIED_LIMITED", "PASS", "FAIL", "TOKEN_VAZIO"]
    },
    "claim_allowed": {"type": "boolean", "const": false},
    "context": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tenant_id", "station_id", "user_scope", "epoch_id", "schema_version", "policy_version"],
      "properties": {
        "tenant_id": {"type": "string", "minLength": 1},
        "station_id": {"type": "string", "minLength": 1},
        "user_scope": {"type": "string", "minLength": 1},
        "epoch_id": {"type": "string", "minLength": 1},
        "schema_version": {"type": "string", "minLength": 1},
        "policy_version": {"type": "string", "minLength": 1}
      }
    },
    "roots": {
      "type": "object",
      "additionalProperties": false,
      "required": ["canonical_sha256", "projected_sha256", "decoy_inventory_sha256", "previous_event_hash"],
      "properties": {
        "canonical_sha256": {"$ref": "#/$defs/sha256"},
        "projected_sha256": {"$ref": "#/$defs/sha256"},
        "decoy_inventory_sha256": {"$ref": "#/$defs/sha256"},
        "previous_event_hash": {"anyOf": [{"$ref": "#/$defs/sha256"}, {"type": "null"}]}
      }
    },
    "fingerprint": {
      "type": "object",
      "additionalProperties": false,
      "required": ["algorithm_id", "codeword_commitment_sha256", "carrier_classes", "detector_version"],
      "properties": {
        "algorithm_id": {"type": "string", "minLength": 1},
        "codeword_commitment_sha256": {"$ref": "#/$defs/sha256"},
        "carrier_classes": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": ["PROJECTED_ID", "CADENCE", "RELATION", "LOGICAL_BLOCK", "AUX_INDEX", "UI_METADATA", "EXPORT_MARK", "DECOY"]
          }
        },
        "detector_version": {"type": "string", "minLength": 1}
      }
    },
    "deception": {
      "type": "object",
      "additionalProperties": false,
      "required": ["isolation_verified", "synthetic_only", "decoy_count", "canonical_write_path_exists"],
      "properties": {
        "isolation_verified": {"type": "boolean"},
        "synthetic_only": {"type": "boolean", "const": true},
        "decoy_count": {"type": "integer", "minimum": 0},
        "canonical_write_path_exists": {"type": "boolean", "const": false}
      }
    },
    "custody": {
      "type": "object",
      "additionalProperties": false,
      "required": ["issued_at", "issuer", "authentication_kind", "authentication_value", "rollback_pointer"],
      "properties": {
        "issued_at": {"type": "string", "format": "date-time"},
        "issuer": {"type": "string", "minLength": 1},
        "authentication_kind": {"enum": ["HMAC_LAB_ONLY", "DIGITAL_SIGNATURE", "TOKEN_VAZIO"]},
        "authentication_value": {"type": "string", "minLength": 1},
        "rollback_pointer": {"type": "string", "minLength": 1}
      }
    },
    "metrics": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "recovery_confidence": {"type": "number", "minimum": 0, "maximum": 1},
        "false_positive_rate": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
        "overhead_p50_ms": {"type": ["number", "null"], "minimum": 0},
        "overhead_p95_ms": {"type": ["number", "null"], "minimum": 0},
        "overhead_p99_ms": {"type": ["number", "null"], "minimum": 0}
      }
    },
    "limitations": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "minLength": 1}
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    }
  }
}
