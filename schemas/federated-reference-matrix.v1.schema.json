{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rafaelia.local/schemas/federated-reference-matrix.v1.schema.json",
  "title": "RAFAELIA Federated Reference Matrix V1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "matrix_id", "claim_allowed", "nodes", "edges", "contexts"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "matrix_id": {"type": "string", "pattern": "^FRM-[A-Z0-9_-]+$"},
    "claim_allowed": {"const": false},
    "nodes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "surface", "authority_role", "locator", "state"],
        "properties": {
          "id": {"type": "string", "pattern": "^N-[A-Z0-9_-]+$"},
          "surface": {"enum": ["GITHUB", "GOOGLE_DRIVE", "RUNTIME", "DOCUMENT", "DATASET", "WORKFLOW", "MEMORY"]},
          "authority_role": {"enum": ["ONTOLOGY", "CONTROL_PLANE", "EVIDENCE", "RUNTIME", "CUSTODY", "PUBLICATION", "RESEARCH", "INDEX"]},
          "locator": {"type": "string", "minLength": 1},
          "state": {"enum": ["CANONICAL", "REFERENCE", "EVIDENCED", "IMPLEMENTED", "RUNTIME", "TOKEN_VAZIO", "HISTORICAL"]},
          "keywords": {"type": "array", "items": {"type": "string"}, "uniqueItems": true}
        }
      }
    },
    "edges": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "from", "to", "relation", "evidence_state"],
        "properties": {
          "id": {"type": "string", "pattern": "^E-[A-Z0-9_-]+$"},
          "from": {"type": "string"},
          "to": {"type": "string"},
          "relation": {"enum": ["GOVERNS", "INDEXES", "PRODUCES", "CONSUMES", "VALIDATES", "CUSTODIES", "REFERENCES", "DEPENDS_ON", "MIRRORS", "REPLICATES"]},
          "evidence_state": {"enum": ["PROVADO", "EVIDENCIADO", "HIPÓTESE", "MODELO_ANALÓGICO", "PARÁBOLA", "REFUTADO", "TOKEN_VAZIO"]},
          "receipt_locator": {"type": ["string", "null"]}
        }
      }
    },
    "contexts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["context_id", "audience", "entry_nodes", "question", "next_gate"],
        "properties": {
          "context_id": {"type": "string", "pattern": "^CTX-[A-Z0-9_-]+$"},
          "audience": {"enum": ["HUMAN", "AI", "ENGINEERING", "RESEARCH", "OPERATIONS", "AUDIT"]},
          "entry_nodes": {"type": "array", "minItems": 1, "items": {"type": "string"}, "uniqueItems": true},
          "question": {"type": "string", "minLength": 1},
          "next_gate": {"type": "string", "minLength": 1}
        }
      }
    }
  }
}
