{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Repository Inventory Schema",
  "description": "Canonical schema for GitHub repository inventory with validation rules",
  "type": "object",
  "required": [
    "generated_at",
    "inventory_source",
    "organizations",
    "repositories"
  ],
  "properties": {
    "generated_at": {
      "type": "string",
      "format": "date-time",
      "description": "ISO-8601 timestamp when inventory was generated"
    },
    "inventory_source": {
      "type": "string",
      "enum": ["github_api", "cache", "manual"],
      "description": "Source of inventory data"
    },
    "inventory_version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+$",
      "description": "Semantic version of inventory format"
    },
    "schema_version": {
      "type": "string",
      "pattern": "^repository_inventory\\.schema\\.v[0-9]+$",
      "description": "Version of this schema"
    },
    "organizations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9-]+$"
      },
      "description": "List of GitHub organizations/users included"
    },
    "collection_method": {
      "type": "string",
      "description": "Method used to collect repository data"
    },
    "validation_status": {
      "type": "string",
      "enum": ["PENDING", "PASS", "FAIL", "PARTIAL"],
      "description": "Status of schema validation"
    },
    "statistics": {
      "type": "object",
      "required": [
        "total_repositories",
        "archived_count",
        "public_count",
        "private_count"
      ],
      "properties": {
        "total_repositories": {
          "type": "integer",
          "minimum": 0
        },
        "archived_count": {
          "type": "integer",
          "minimum": 0
        },
        "public_count": {
          "type": "integer",
          "minimum": 0
        },
        "private_count": {
          "type": "integer",
          "minimum": 0
        },
        "organizations_count": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "repositories": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "repository_full_name",
          "repository_id",
          "owner",
          "repository_name",
          "url",
          "default_branch",
          "visibility",
          "archived",
          "size_bytes",
          "created_at",
          "updated_at",
          "pushed_at",
          "evidence_status"
        ],
        "properties": {
          "repository_full_name": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9-]+/[a-zA-Z0-9._-]+$",
            "description": "GitHub repository identifier (owner/name)"
          },
          "repository_id": {
            "type": "integer",
            "minimum": 1,
            "description": "GitHub unique repository ID (stable identifier)"
          },
          "owner": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9-]+$"
          },
          "repository_name": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9._-]+$"
          },
          "url": {
            "type": "string",
            "format": "uri",
            "pattern": "^https://github\\.com/"
          },
          "api_url": {
            "type": "string",
            "format": "uri"
          },
          "default_branch": {
            "type": "string",
            "minLength": 1
          },
          "visibility": {
            "type": "string",
            "enum": ["public", "private"]
          },
          "archived": {
            "type": "boolean"
          },
          "size_bytes": {
            "type": "integer",
            "minimum": 0
          },
          "language": {
            "type": ["string", "null"],
            "description": "Primary programming language or null"
          },
          "description": {
            "type": ["string", "null"]
          },
          "topics": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          },
          "updated_at": {
            "type": "string",
            "format": "date-time"
          },
          "pushed_at": {
            "type": "string",
            "format": "date-time"
          },
          "homepage": {
            "type": ["string", "null"],
            "format": "uri"
          },
          "stars": {
            "type": "integer",
            "minimum": 0
          },
          "forks": {
            "type": "integer",
            "minimum": 0
          },
          "open_issues": {
            "type": "integer",
            "minimum": 0
          },
          "watchers": {
            "type": "integer",
            "minimum": 0
          },
          "has_issues": {
            "type": "boolean"
          },
          "has_projects": {
            "type": "boolean"
          },
          "has_downloads": {
            "type": "boolean"
          },
          "has_wiki": {
            "type": "boolean"
          },
          "has_pages": {
            "type": "boolean"
          },
          "is_template": {
            "type": "boolean"
          },
          "evidence_status": {
            "type": "string",
            "enum": ["FATO", "HIPOTESE", "SIMBOLICO", "LACUNA"],
            "description": "Epistemic mark: evidence reliability"
          },
          "first_seen_at": {
            "type": "string",
            "format": "date-time"
          },
          "sync_status": {
            "type": "string",
            "enum": ["CURRENT", "STALE", "NEEDS_REFRESH"],
            "description": "Freshness of this repository data"
          }
        },
        "additionalProperties": false
      }
    },
    "notes": {
      "type": "object",
      "description": "Documentation notes and metadata"
    },
    "digest_blake2b": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$|^TOKEN_VAZIO.*$",
      "description": "BLAKE2b hash of repository list for integrity verification"
    }
  },
  "additionalProperties": false
}
