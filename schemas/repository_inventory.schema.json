{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/rafaelmeloreisnovo/Mapa/schemas/repository_inventory.schema.json",
  "title": "Repository Inventory v2 — connector-backed fail-closed snapshot",
  "type": "object",
  "required": [
    "schema",
    "schema_version",
    "generated_at",
    "inventory_source",
    "collection_method",
    "scope",
    "statistics",
    "repositories",
    "absence_ledger",
    "integrity"
  ],
  "properties": {
    "schema": {
      "const": "repository_inventory_v2"
    },
    "schema_version": {
      "const": "2.0.0"
    },
    "generated_at": {
      "type": "string"
    },
    "inventory_source": {
      "const": "github_connector"
    },
    "collection_method": {
      "type": "string",
      "minLength": 1
    },
    "scope": {
      "type": "object",
      "required": [
        "state",
        "claim_allowed",
        "included_accounts",
        "accessible_total_observed",
        "materialized_count",
        "completeness_ratio"
      ]
    },
    "statistics": {
      "type": "object",
      "required": [
        "materialized_count",
        "public_count",
        "private_count",
        "archived_count",
        "owner_counts"
      ]
    },
    "repositories": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "repository_full_name",
          "repository_id",
          "owner",
          "repository_name",
          "clone_url",
          "default_branch",
          "visibility",
          "archived",
          "size_kib",
          "metadata_status",
          "claim_scope",
          "observed_via"
        ]
      }
    },
    "absence_ledger": {
      "type": "object",
      "required": [
        "state",
        "missing_materialized_records",
        "reason",
        "owner",
        "next_action",
        "exit_criteria"
      ]
    },
    "integrity": {
      "type": "object",
      "required": [
        "algorithm",
        "canonicalization",
        "digest"
      ]
    }
  },
  "additionalProperties": false,
  "x-validation-note": "The executable validator is scripts/validate_repository_inventory.py and uses only Python stdlib. This schema is descriptive and must not be treated as proof by itself."
}
