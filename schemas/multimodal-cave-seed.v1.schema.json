{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rafaelia.example/schemas/multimodal-cave-seed.v1.schema.json",
  "title": "RAFAELIA MULTIMODAL_CAVE_SEED_V1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "seed_id",
    "generated_at",
    "state",
    "claim_allowed",
    "baseline",
    "authority",
    "hypothesis",
    "invariants",
    "bit_codec_contract",
    "concepts",
    "objects",
    "representations",
    "transforms",
    "tiles",
    "relations",
    "route_prefaces",
    "mathematical_anchors",
    "gaps",
    "editorial_mirror",
    "r3"
  ],
  "properties": {
    "schema": {"const": "rafaelia.multimodal_cave_seed.v1"},
    "seed_id": {"const": "MULTIMODAL_CAVE_SEED_V1"},
    "generated_at": {"type": "string", "format": "date-time"},
    "state": {"const": "VERIFIED_LIMITED"},
    "claim_allowed": {"const": false},
    "baseline": {"type": "object"},
    "authority": {"type": "object"},
    "hypothesis": {"type": "object"},
    "invariants": {"type": "array", "minItems": 8, "uniqueItems": true, "items": {"type": "string"}},
    "bit_codec_contract": {"type": "object"},
    "concepts": {"type": "array", "minItems": 1, "items": {"type": "object"}},
    "objects": {"type": "array", "minItems": 1, "items": {"$ref": "multimodal-object.v1.schema.json"}},
    "representations": {"type": "array", "minItems": 1, "items": {"$ref": "multimodal-representation.v1.schema.json"}},
    "transforms": {"type": "array", "minItems": 1, "items": {"$ref": "multimodal-transform.v1.schema.json"}},
    "tiles": {"type": "array", "minItems": 1, "items": {"$ref": "semantic-tile.v1.schema.json"}},
    "relations": {"type": "array", "items": {"type": "object"}},
    "route_prefaces": {"type": "array", "minItems": 1, "items": {"$ref": "route-preface.v1.schema.json"}},
    "mathematical_anchors": {"type": "array", "minItems": 1, "items": {"type": "object"}},
    "gaps": {"type": "array", "minItems": 1, "items": {"type": "object"}},
    "editorial_mirror": {"type": "object"},
    "r3": {"type": "object"}
  }
}
