{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/rafaelmeloreisnovo/Mapa/schemas/private_chunk_hash_index_manifest.v1.schema.json",
  "title": "RAFAELIA private chunk hash index manifest v1",
  "type": "object",
  "required": [
    "schema",
    "corpus_alias",
    "public_safe",
    "raw_content_included",
    "commitment_mode",
    "leaf_count",
    "public_navigation_root_sha256",
    "index_invariants",
    "chunks",
    "claim_allowed"
  ],
  "properties": {
    "schema": {"const": "rafaelia.private_chunk_hash_index_manifest.v1"},
    "corpus_alias": {"type": "string", "minLength": 1},
    "public_safe": {"const": true},
    "raw_content_included": {"const": false},
    "commitment_mode": {"enum": ["BLAKE3-256-KEYED", "HMAC-SHA256", "SHA-256"]},
    "leaf_count": {"type": "integer", "minimum": 1},
    "public_navigation_root_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "index_invariants": {
      "type": "array",
      "minItems": 10,
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^IDX-[A-Z0-9-]+$"}
    },
    "chunks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["ordinal", "opaque_id", "commitment", "temporal_index", "relation_index", "evidence_state"],
        "properties": {
          "ordinal": {"type": "integer", "minimum": 0},
          "opaque_id": {"type": "string", "pattern": "^CHUNK-[A-Z0-9_-]+$"},
          "commitment": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "temporal_index": {"type": "string", "minLength": 1},
          "relation_index": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
          "evidence_state": {"enum": ["COMMITMENT_ONLY", "HASH_AND_RECEIPT", "TOKEN_VAZIO"]}
        },
        "additionalProperties": false
      }
    },
    "claim_allowed": {"const": false}
  },
  "additionalProperties": false
}
