{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rafaelia.example/schemas/seed-omega-evolution.v1.schema.json",
  "title": "RAFAELIA SEED_OMEGA_EVOLUTION_V1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "seed_id",
    "generated_at",
    "state",
    "claim_allowed",
    "generation",
    "parents",
    "genotype",
    "phenotype",
    "operator_set",
    "scale_contract",
    "environment",
    "lineage",
    "evaluation",
    "provenance",
    "gaps",
    "r3"
  ],
  "properties": {
    "schema": {
      "const": "rafaelia.seed_omega_evolution.v1"
    },
    "seed_id": {
      "type": "string",
      "minLength": 1
    },
    "generated_at": {
      "type": "string",
      "format": "date-time"
    },
    "state": {
      "enum": [
        "CANONICAL_DRAFT",
        "MODEL_DEFINED",
        "VERIFIED_LIMITED",
        "TOKEN_VAZIO"
      ]
    },
    "claim_allowed": {
      "const": false
    },
    "generation": {
      "type": "integer",
      "minimum": 0
    },
    "parents": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "genotype": {
      "type": "object"
    },
    "phenotype": {
      "type": "object"
    },
    "operator_set": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": [
          "DIRECT",
          "INVERSE",
          "REVERSE",
          "ANTIDERIVATIVE",
          "RECLUSIVE_CLOSURE",
          "LOG",
          "ITERATED_LOG",
          "TANGENTIAL",
          "ORTHOGONAL",
          "TRANSVERSAL",
          "LATERAL",
          "RECURSIVE",
          "RECOMBINE",
          "PERMUTE",
          "GEODESIC_STEP"
        ]
      }
    },
    "scale_contract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "q",
        "formula",
        "boundary"
      ],
      "properties": {
        "q": {
          "const": "sqrt(3)/2"
        },
        "formula": {
          "const": "a_n=a_0*(sqrt(3)/2)^n"
        },
        "boundary": {
          "const": "EUCLIDEAN_SCALE_NOT_AUTOMATIC_HYPERBOLIC_GEODESIC"
        }
      }
    },
    "environment": {
      "type": "object"
    },
    "lineage": {
      "type": "object",
      "required": [
        "append_only",
        "preserve_ancestors"
      ],
      "properties": {
        "append_only": {
          "const": true
        },
        "preserve_ancestors": {
          "const": true
        },
        "supersedes": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "evaluation": {
      "type": "object",
      "required": [
        "dimensions",
        "selection_rule"
      ],
      "properties": {
        "dimensions": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "coherence",
              "novelty",
              "reconstruction",
              "evidence",
              "robustness",
              "cost"
            ]
          }
        },
        "selection_rule": {
          "enum": [
            "PARETO_FRONT",
            "EXPLICIT_RULE",
            "TOKEN_VAZIO"
          ]
        }
      }
    },
    "provenance": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object"
      }
    },
    "gaps": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "r3": {
      "type": "object",
      "required": [
        "F_ok",
        "F_gap",
        "F_next"
      ],
      "properties": {
        "F_ok": {
          "type": "string"
        },
        "F_gap": {
          "type": "string"
        },
        "F_next": {
          "type": "string"
        }
      }
    }
  }
}
