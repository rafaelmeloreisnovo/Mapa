{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rafaelia.local/schemas/shared_data/share_release_manifest.v1.schema.json",
  "title": "RAFAELIA Shared Data Release Manifest V1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "share_id",
    "source_locator",
    "source_revision_or_sha256",
    "source_criticality",
    "fragment_sha256",
    "fragment_size",
    "purpose",
    "allowed_repository",
    "allowed_workflow",
    "allowed_operation",
    "created_at",
    "expires_at",
    "redaction_status",
    "reidentification_risk",
    "semantic_reconstruction_risk",
    "approval_state",
    "revoked",
    "credential_or_secret_presence",
    "claim_allowed",
    "token_vazio"
  ],
  "properties": {
    "schema_version": {"const": "rafaelia.shared-data-release/v1"},
    "share_id": {"type": "string", "pattern": "^SHARE-[A-Za-z0-9._-]+$"},
    "source_locator": {"type": "string", "minLength": 1},
    "source_revision_or_sha256": {"type": "string", "minLength": 1},
    "source_criticality": {"enum": ["C0_PUBLIC", "C1_INTERNAL", "C2_SENSITIVE", "C3_RESTRICTED", "C4_CRITICAL"]},
    "fragment_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "fragment_size": {"type": "integer", "minimum": 0},
    "purpose": {"type": "string", "minLength": 1},
    "allowed_repository": {"type": "string", "pattern": "^[^/]+/[^/]+$"},
    "allowed_workflow": {"type": "string", "minLength": 1},
    "allowed_operation": {"type": "string", "minLength": 1},
    "created_at": {"type": "string", "minLength": 1},
    "expires_at": {"type": "string", "minLength": 1},
    "redaction_status": {"enum": ["NOT_REQUIRED", "PASS", "FAIL", "TOKEN_VAZIO"]},
    "reidentification_risk": {"enum": ["LOW", "MEDIUM", "HIGH", "TOKEN_VAZIO"]},
    "semantic_reconstruction_risk": {"enum": ["LOW", "MEDIUM", "HIGH", "TOKEN_VAZIO"]},
    "downstream_effects_summary": {"type": "string"},
    "human_awareness_summary": {"type": "string"},
    "approval_state": {"enum": ["BLOCKED", "APPROVED_LIMITED", "APPROVED", "REJECTED", "EXPIRED", "REVOKED"]},
    "human_approval": {"type": ["boolean", "null"]},
    "revoked": {"type": "boolean"},
    "credential_or_secret_presence": {"enum": [true, false, "TOKEN_VAZIO"]},
    "claim_allowed": {"const": false},
    "token_vazio": {"type": "array", "items": {"type": "string"}}
  }
}
