{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rafaelia.local/schemas/manifold-model-gap-matrix-v1.json",
  "title": "RAFAELIA Model Gap Matrix V1",
  "type": "object",
  "required": [
    "schema_version",
    "registry_id",
    "generated_from",
    "invariant",
    "claim_allowed",
    "models"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "registry_id": {
      "const": "RAFAELIA_MODEL_GAP_MATRIX_V1"
    },
    "generated_from": {
      "type": "object"
    },
    "invariant": {
      "type": "string",
      "minLength": 1
    },
    "claim_allowed": {
      "const": false
    },
    "models": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "model_id",
          "model",
          "state",
          "gap_kind",
          "gap",
          "token_vazio",
          "linked_gap_refs",
          "evidence_needed",
          "closure_criterion",
          "next"
        ],
        "properties": {
          "model_id": {
            "type": "string",
            "pattern": "^M[0-9]{2}$"
          },
          "model": {
            "type": "string",
            "minLength": 1
          },
          "state": {
            "type": "string",
            "minLength": 1
          },
          "gap_kind": {
            "type": "string",
            "minLength": 1
          },
          "gap": {
            "type": "string",
            "minLength": 1
          },
          "token_vazio": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^TOKEN_VAZIO"
            }
          },
          "linked_gap_refs": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^G[0-9]{4}$"
            }
          },
          "evidence_needed": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "closure_criterion": {
            "type": "string",
            "minLength": 1
          },
          "next": {
            "type": "string",
            "minLength": 1
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
