{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rafaelia.local/schemas/manifold-gap-v1.schema.json",
  "title": "RAFAELIA Manifold Gap V1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "gap_id",
    "parent_gap_id",
    "kind",
    "summary",
    "origin_ref",
    "expected_type",
    "state",
    "decomposition_state",
    "child_gap_refs",
    "evidence_needed",
    "closure_criterion",
    "catalog_reduction",
    "noise",
    "markers",
    "claim_allowed"
  ],
  "properties": {
    "gap_id": {
      "type": "string",
      "pattern": "^G[0-9]{4,}$"
    },
    "parent_gap_id": {
      "type": ["string", "null"],
      "pattern": "^G[0-9]{4,}$"
    },
    "kind": {
      "type": "string",
      "enum": [
        "MISSING_SOURCE",
        "MISSING_EXECUTION",
        "MISSING_EVIDENCE",
        "MISSING_MAPPING",
        "MISSING_DECOMPOSITION",
        "MISSING_METRIC",
        "UNRESOLVED_AMBIGUITY",
        "OPEN_COVERAGE",
        "SYMBOLIC_SEMANTICS_UNBOUND"
      ]
    },
    "summary": {
      "type": "string",
      "minLength": 1
    },
    "origin_ref": {
      "type": "string",
      "minLength": 1
    },
    "expected_type": {
      "type": "string",
      "minLength": 1
    },
    "state": {
      "type": "string",
      "enum": [
        "TOKEN_VAZIO_NAVIGABLE",
        "TOKEN_VAZIO_NESTED",
        "TOKEN_VAZIO_NOT_RUN",
        "TOKEN_VAZIO_AMBIGUOUS",
        "PARTIAL_BOUNDED",
        "CLOSED_VERIFIED",
        "SUPERSEDED"
      ]
    },
    "decomposition_state": {
      "type": "string",
      "enum": [
        "DECOMPOSED",
        "PARTIAL",
        "TOKEN_VAZIO_UNDECOMPOSED",
        "NOT_APPLICABLE"
      ]
    },
    "child_gap_refs": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^G[0-9]{4,}$"
      }
    },
    "evidence_needed": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "closure_criterion": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "catalog_reduction": {
      "type": "object",
      "additionalProperties": false,
      "required": ["before", "after", "method", "complexity_claim"],
      "properties": {
        "before": {
          "type": "string",
          "enum": ["NP_CATALOG", "P_CATALOG", "TOKEN_VAZIO"]
        },
        "after": {
          "type": "string",
          "enum": ["NP_CATALOG", "P_CATALOG", "TOKEN_VAZIO"]
        },
        "method": {
          "type": "string",
          "minLength": 1
        },
        "complexity_claim": {
          "const": false
        }
      }
    },
    "noise": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "class",
        "delta_p_catalog",
        "delta_np_catalog",
        "delta_section_noise",
        "classification_note"
      ],
      "properties": {
        "class": {
          "type": "string",
          "enum": [
            "NONE",
            "DELTA_P",
            "DELTA_NP",
            "DELTA_SECTION_NOISE",
            "MIXED",
            "TOKEN_VAZIO_UNCLASSIFIED"
          ]
        },
        "delta_p_catalog": {
          "type": ["number", "null"]
        },
        "delta_np_catalog": {
          "type": ["number", "null"]
        },
        "delta_section_noise": {
          "type": ["number", "null"]
        },
        "classification_note": {
          "type": "string"
        }
      }
    },
    "markers": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "claim_allowed": {
      "const": false
    }
  }
}
