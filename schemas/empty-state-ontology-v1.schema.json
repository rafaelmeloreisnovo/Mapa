{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rafaelia.local/schemas/empty-state-ontology-v1.schema.json",
  "title": "RAFAELIA Empty State Ontology V1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "version",
    "date",
    "state",
    "authority",
    "claim_allowed",
    "invariants",
    "center_binding",
    "coercion_policy",
    "states",
    "hard_distinctions",
    "omega8_projection",
    "transitions",
    "gaps"
  ],
  "properties": {
    "schema": {
      "const": "rafaelia.empty-state-ontology.v1"
    },
    "version": {
      "type": "string"
    },
    "date": {
      "type": "string"
    },
    "state": {
      "type": "string"
    },
    "authority": {
      "type": "string"
    },
    "claim_allowed": {
      "const": false
    },
    "invariants": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "center_binding": {
      "type": "object",
      "required": [
        "source",
        "legacy_expression",
        "refined_semantic_type",
        "representation_marker",
        "rule"
      ]
    },
    "coercion_policy": {
      "type": "object",
      "required": [
        "mode",
        "default",
        "rule"
      ]
    },
    "states": {
      "type": "array",
      "minItems": 13,
      "maxItems": 13,
      "items": {
        "type": "object",
        "required": [
          "id",
          "class",
          "definition",
          "requires_context",
          "evidence_rule",
          "forbidden_inferences",
          "promotable"
        ]
      }
    },
    "hard_distinctions": {
      "type": "array",
      "minItems": 10,
      "items": {
        "type": "array",
        "minItems": 2,
        "maxItems": 2,
        "items": {
          "type": "string"
        }
      }
    },
    "omega8_projection": {
      "type": "array",
      "minItems": 8,
      "maxItems": 8,
      "items": {
        "type": "object",
        "required": [
          "direction",
          "operator",
          "rule"
        ]
      }
    },
    "transitions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "from",
          "to",
          "allowed",
          "requires"
        ]
      }
    },
    "gaps": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "state",
          "summary",
          "closure"
        ]
      }
    }
  }
}
