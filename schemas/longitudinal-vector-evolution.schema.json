{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rafaelia.example/schemas/longitudinal-vector-evolution.v1.schema.json",
  "title": "RAFAELIA Longitudinal Vector Evolution V1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema", "vector_id", "revision", "previous_revision", "source",
    "layers", "delta", "invariants", "gates", "weights", "state",
    "claim_allowed", "next_gate"
  ],
  "properties": {
    "schema": {"const": "rafaelia.longitudinal-vector-evolution/v1"},
    "vector_id": {"type": "string", "pattern": "^rafvec1-[a-z0-9][a-z0-9._-]{2,127}$"},
    "revision": {"type": "integer", "minimum": 1},
    "previous_revision": {"type": ["integer", "null"], "minimum": 1},
    "previous_event_hash": {
      "type": ["string", "null"],
      "pattern": "^([a-f0-9]{64}|TOKEN_VAZIO_[A-Z0-9_]+)$"
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_id", "source_type", "source_pointer", "observed_at", "source_sha256", "hidden_model_access"],
      "properties": {
        "source_id": {"type": "string", "minLength": 3},
        "source_type": {
          "enum": ["SOURCE_SNAPSHOT", "SESSION_PARABLE_MULTI_VIEW", "GITHUB_ARTIFACT", "DRIVE_CANONICAL_APPEND", "LOCAL_RECEIPT"]
        },
        "source_pointer": {"type": "string", "minLength": 1},
        "observed_at": {"type": "string", "format": "date-time"},
        "source_sha256": {"type": "string", "pattern": "^([a-f0-9]{64}|TOKEN_VAZIO_[A-Z0-9_]+)$"},
        "hidden_model_access": {"const": false}
      }
    },
    "layers": {
      "type": "object",
      "additionalProperties": false,
      "required": ["hexagonal", "polysemic", "operational", "epistemic", "relational", "temporal"],
      "properties": {
        "hexagonal": {
          "type": "object",
          "additionalProperties": false,
          "required": ["origin", "readability", "semantics", "dynamics", "synergy", "custody"],
          "properties": {
            "origin": {"$ref": "#/$defs/layerState"},
            "readability": {"$ref": "#/$defs/layerState"},
            "semantics": {"$ref": "#/$defs/layerState"},
            "dynamics": {"$ref": "#/$defs/layerState"},
            "synergy": {"$ref": "#/$defs/layerState"},
            "custody": {"$ref": "#/$defs/layerState"}
          }
        },
        "polysemic": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/view"}
        },
        "operational": {
          "type": "object",
          "additionalProperties": false,
          "required": ["input", "transform", "output", "test", "receipt"],
          "properties": {
            "input": {"type": "string"},
            "transform": {"type": "string"},
            "output": {"type": "string"},
            "test": {"type": "string"},
            "receipt": {"type": "string"}
          }
        },
        "epistemic": {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "confidence", "typed_gaps", "falsifier"],
          "properties": {
            "status": {"enum": ["KNOWS", "FELTS", "TOKEN_VAZIO", "TOKEN_VAZIO_QUANTIFICADO", "CONTRADICTED", "REFUTED"]},
            "confidence": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
            "typed_gaps": {"type": "array", "items": {"type": "string", "pattern": "^TOKEN_VAZIO_[A-Z0-9_]+$"}},
            "falsifier": {"type": "string", "minLength": 1}
          }
        },
        "relational": {
          "type": "array",
          "items": {"$ref": "#/$defs/relation"}
        },
        "temporal": {
          "type": "object",
          "additionalProperties": false,
          "required": ["first_observed_at", "current_observed_at", "lineage"],
          "properties": {
            "first_observed_at": {"type": "string", "format": "date-time"},
            "current_observed_at": {"type": "string", "format": "date-time"},
            "lineage": {"type": "array", "minItems": 1, "items": {"type": "string"}}
          }
        }
      }
    },
    "delta": {
      "type": "object",
      "additionalProperties": false,
      "required": ["added_dimensions", "changed_dimensions", "preserved_dimensions", "removed_dimensions", "supersession_receipt"],
      "properties": {
        "added_dimensions": {"type": "array", "items": {"$ref": "#/$defs/dimension"}},
        "changed_dimensions": {"type": "array", "items": {"$ref": "#/$defs/change"}},
        "preserved_dimensions": {"type": "array", "items": {"type": "string"}},
        "removed_dimensions": {"type": "array", "items": {"type": "string"}},
        "supersession_receipt": {"type": ["string", "null"]}
      }
    },
    "invariants": {
      "type": "array",
      "minItems": 5,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 3}
    },
    "gates": {
      "type": "object",
      "additionalProperties": false,
      "required": ["provenance", "delta_identity", "semantic_consistency", "evidence_or_typed_gap", "reversibility"],
      "properties": {
        "provenance": {"type": "boolean"},
        "delta_identity": {"type": "boolean"},
        "semantic_consistency": {"type": "boolean"},
        "evidence_or_typed_gap": {"type": "boolean"},
        "reversibility": {"type": "boolean"}
      }
    },
    "weights": {
      "type": "array",
      "items": {"$ref": "#/$defs/weight"}
    },
    "state": {"enum": ["EVOLVED_LOCAL", "BLOCKED", "TOKEN_VAZIO_VECTOR_DELTA"]},
    "claim_allowed": {"const": false},
    "next_gate": {"type": "string", "minLength": 3}
  },
  "$defs": {
    "layerState": {
      "type": "object",
      "additionalProperties": false,
      "required": ["state", "value", "source_ref"],
      "properties": {
        "state": {"enum": ["OBSERVED", "DERIVED", "INTERPRETED", "HYPOTHESIS", "TOKEN_VAZIO", "CONTRADICTED"]},
        "value": {},
        "source_ref": {"type": "string", "minLength": 1}
      }
    },
    "view": {
      "type": "object",
      "additionalProperties": false,
      "required": ["view_id", "view_type", "state", "content", "source_ref", "forbidden_promotions"],
      "properties": {
        "view_id": {"type": "string", "minLength": 3},
        "view_type": {"enum": ["LITERAL", "TECHNICAL_MAPPING", "PARABLE", "SYMBOLIC", "OPERATIONAL", "CONTRADICTION", "TOKEN_VAZIO"]},
        "state": {"enum": ["OBSERVED", "DERIVED", "INTERPRETED", "HYPOTHESIS", "TOKEN_VAZIO", "CONTRADICTED"]},
        "content": {},
        "source_ref": {"type": "string", "minLength": 1},
        "forbidden_promotions": {"type": "array", "items": {"type": "string"}}
      }
    },
    "relation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["from", "type", "to", "source_ref"],
      "properties": {
        "from": {"type": "string", "minLength": 1},
        "type": {"enum": ["DERIVED_FROM", "SUPPORTED_BY", "CONTRADICTS", "ALTERNATIVE_TO", "TESTED_BY", "BOUNDED_BY", "RETURNS_TO", "EVOLVES_INTO"]},
        "to": {"type": "string", "minLength": 1},
        "source_ref": {"type": "string", "minLength": 1}
      }
    },
    "dimension": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "data_type", "semantics", "source_ref", "initial_state"],
      "properties": {
        "name": {"type": "string", "pattern": "^[a-z][a-z0-9_]{2,63}$"},
        "data_type": {"enum": ["string", "integer", "number", "boolean", "object", "array", "token_vazio"]},
        "semantics": {"type": "string", "minLength": 8},
        "source_ref": {"type": "string", "minLength": 1},
        "initial_state": {"enum": ["OBSERVED", "DERIVED", "INTERPRETED", "HYPOTHESIS", "TOKEN_VAZIO"]}
      }
    },
    "change": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "before", "after", "reason", "source_ref"],
      "properties": {
        "name": {"type": "string"},
        "before": {},
        "after": {},
        "reason": {"type": "string", "minLength": 3},
        "source_ref": {"type": "string", "minLength": 1}
      }
    },
    "weight": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "status", "value", "evidence_refs"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "status": {"enum": ["CALIBRATED", "TOKEN_VAZIO_CALIBRATION"]},
        "value": {"type": ["number", "null"]},
        "evidence_refs": {"type": "array", "items": {"type": "string"}}
      }
    }
  }
}
