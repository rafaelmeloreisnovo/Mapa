{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/rafaelmeloreisnovo/Mapa/schemas/map_invariant_registry.v1.schema.json",
  "title": "RAFAELIA Mapa Invariant Registry V1",
  "description": "Universal append-only contract for declared, implemented, tested and evidenced invariants. Schema validity is structural evidence only and never promotes a scientific or physical claim.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "invariant_id",
    "version",
    "family",
    "canonical_statement",
    "scope",
    "authority",
    "source",
    "validators",
    "tests",
    "workflows",
    "receipts",
    "dependencies",
    "falsifiers",
    "verification_vector",
    "urgency",
    "urgency_reason",
    "claim_allowed",
    "token_vazio_reason",
    "next_verifiable_step"
  ],
  "properties": {
    "schema_version": {"const": "map.invariant/v1"},
    "invariant_id": {"type": "string", "pattern": "^MAP-INV-[A-Z0-9_-]{3,64}$"},
    "version": {"type": "integer", "minimum": 1},
    "family": {
      "type": "string",
      "enum": ["epistemic", "provenance", "topology", "execution", "context", "longitudinal", "federation", "branch", "supply_chain", "scientific"]
    },
    "canonical_statement": {"type": "string", "minLength": 12},
    "scope": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "required": ["control_plane", "implementation", "evidence"],
      "properties": {
        "control_plane": {"type": "string", "minLength": 1},
        "implementation": {"type": "string", "minLength": 1},
        "evidence": {"type": "string", "minLength": 1}
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "blob_sha", "producer_commit_sha", "observed_at_commit_sha"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "blob_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "producer_commit_sha": {"type": "string", "pattern": "^([0-9a-f]{40}|TOKEN_VAZIO_[A-Z0-9_]+)$"},
        "observed_at_commit_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"}
      }
    },
    "validators": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "tests": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "workflows": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "receipts": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "dependencies": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^MAP-INV-[A-Z0-9_-]{3,64}$"}},
    "falsifiers": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 8}},
    "verification_vector": {
      "type": "object",
      "additionalProperties": false,
      "required": ["D", "I", "T", "C", "X", "F"],
      "properties": {
        "D": {"$ref": "#/$defs/gateState"},
        "I": {"$ref": "#/$defs/gateState"},
        "T": {"$ref": "#/$defs/gateState"},
        "C": {"$ref": "#/$defs/gateState"},
        "X": {"$ref": "#/$defs/gateState"},
        "F": {"$ref": "#/$defs/gateState"}
      }
    },
    "urgency": {"type": "string", "enum": ["P0_CRITICAL", "P1_URGENT", "P2_NECESSARY", "P3_IMPORTANT", "P4_BACKLOG"]},
    "urgency_reason": {"type": "string", "minLength": 8},
    "claim_allowed": {"type": "boolean"},
    "token_vazio_reason": {"type": ["string", "null"]},
    "next_verifiable_step": {"type": "string", "minLength": 8}
  },
  "$defs": {
    "gateState": {
      "type": "string",
      "pattern": "^(PASS|NOT_APPLICABLE|TOKEN_VAZIO_[A-Z0-9_]+)$"
    }
  }
}
