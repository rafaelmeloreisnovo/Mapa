{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rafaelia.example/schemas/route-preface.v1.schema.json",
  "title": "RAFAELIA route preface v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "preface_id",
    "parent_preface_id",
    "depth",
    "target_ids",
    "audience",
    "question",
    "prerequisites",
    "exclusions",
    "route",
    "source_ids",
    "claim_allowed"
  ],
  "properties": {
    "preface_id": {"type": "string", "pattern": "^PREFACE-[A-Z0-9-]+$"},
    "parent_preface_id": {"type": ["string", "null"]},
    "depth": {"type": "integer", "minimum": 0, "maximum": 4},
    "target_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}},
    "audience": {"type": "string", "minLength": 1},
    "question": {"type": "string", "minLength": 3},
    "prerequisites": {"type": "array", "items": {"type": "string"}},
    "exclusions": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "route": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "source_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}},
    "claim_allowed": {"const": false}
  }
}
