{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/rafaelmeloreisnovo/Mapa/schemas/session-universe-audit.schema.json",
  "title": "Session Universe 456 Audit",
  "type": "object",
  "required": [
    "schema_version",
    "event_id",
    "governance",
    "declared_counts",
    "counting_convention",
    "clusters",
    "atomic_registry",
    "results",
    "operators",
    "transformer_seeds",
    "meta_syntheses",
    "review_queue"
  ],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "event_id": {"const": "SESSION-UNIVERSE-456-20260728"},
    "governance": {
      "type": "object",
      "required": ["claim_allowed", "review_policy", "missing_data_policy"],
      "properties": {
        "claim_allowed": {"const": false},
        "review_policy": {"const": "ONE_BY_ONE"},
        "missing_data_policy": {"const": "TOKEN_VAZIO"}
      }
    },
    "atomic_registry": {
      "type": "object",
      "required": ["ids", "default"],
      "properties": {
        "ids": {
          "type": "array",
          "minItems": 416,
          "maxItems": 416,
          "uniqueItems": true,
          "items": {"type": "string", "pattern": "^ATOM-[0-9]{3}$"}
        },
        "default": {
          "type": "object",
          "required": ["name", "reviewed", "state", "claim_allowed"],
          "properties": {
            "name": {"const": null},
            "reviewed": {"const": false},
            "state": {"const": "TOKEN_VAZIO_SOURCE_ENUMERATION_PENDING"},
            "claim_allowed": {"const": false}
          }
        }
      }
    },
    "clusters": {"type": "array", "minItems": 8, "maxItems": 8},
    "results": {"type": "array", "minItems": 24, "maxItems": 24, "items": {"$ref": "#/$defs/entity"}},
    "operators": {"type": "array", "minItems": 3, "maxItems": 3, "items": {"$ref": "#/$defs/entity"}},
    "transformer_seeds": {"type": "array", "minItems": 5, "maxItems": 5, "items": {"$ref": "#/$defs/entity"}},
    "meta_syntheses": {"type": "array", "minItems": 1, "maxItems": 1, "items": {"$ref": "#/$defs/entity"}}
  },
  "$defs": {
    "entity": {
      "type": "object",
      "required": ["id", "state", "claim_allowed"],
      "properties": {
        "id": {"type": "string"},
        "name": {"type": ["string", "null"]},
        "state": {"type": "string", "minLength": 1},
        "claim_allowed": {"const": false},
        "reviewed": {"type": "boolean"}
      }
    }
  }
}
