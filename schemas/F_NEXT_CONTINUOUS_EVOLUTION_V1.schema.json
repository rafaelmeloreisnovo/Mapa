{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rafaelia.local/schemas/F_NEXT_CONTINUOUS_EVOLUTION_V1.schema.json",
  "title": "RAFAELIA F_next Continuous Evolution V1",
  "description": "Append-only contract linking urgency, risk mitigation, provenance, evidence, falsifier, gate and claim promotion without converting unknowns into facts.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version","chain_id","recorded_at","append_only","claim_allowed","risk_model_ref","priority_contract_ref","mother_invariants","claim_ladder","stages","continuous_loop"],
  "properties": {
    "schema_version": {"const": "rafaelia.f-next-continuous-evolution/v1"},
    "chain_id": {"type": "string", "minLength": 8},
    "recorded_at": {"type": "string", "format": "date-time"},
    "append_only": {"const": true},
    "claim_allowed": {"const": false},
    "risk_model_ref": {"type": "string", "minLength": 1},
    "priority_contract_ref": {"type": "string", "minLength": 1},
    "mother_invariants": {"type": "array", "minItems": 5, "uniqueItems": true, "items": {"type": "string", "minLength": 3}},
    "claim_ladder": {
      "type": "array", "minItems": 5, "uniqueItems": true,
      "items": {"enum": ["OBSERVATION","EVIDENCED_OBSERVATION","BOUNDED_CLAIM","PRECISE_CLAIM","GENERAL_CLAIM"]}
    },
    "stages": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["id","order","state","priority","urgency","scope","problem","objective","risk_vector","provenance","required_evidence","falsifier","closure_condition","mitigations","forbidden_promotions","dependencies","claim_target","next_on_pass","next_on_fail"],
        "properties": {
          "id": {"type": "string", "pattern": "^FN-[A-Z0-9_-]+$"},
          "order": {"type": "integer", "minimum": 1},
          "state": {"enum": ["READY","ACTIVE","WAITING_EXTERNAL_RUNTIME","BLOCKED","TOKEN_VAZIO","CLOSED_PASS","CLOSED_FAIL","SUPERSEDED"]},
          "priority": {"enum": ["P0","P1","P2","P3"]},
          "urgency": {"enum": ["NOW","NEXT","SCHEDULED","DEFERRED"]},
          "scope": {"type": "string", "minLength": 3},
          "problem": {"type": "string", "minLength": 3},
          "objective": {"type": "string", "minLength": 3},
          "risk_vector": {
            "type": "object", "additionalProperties": false,
            "required": ["A","S","P","G","I","V","C","U"],
            "properties": {
              "A": {"$ref": "#/$defs/riskState"}, "S": {"$ref": "#/$defs/riskState"},
              "P": {"$ref": "#/$defs/riskState"}, "G": {"$ref": "#/$defs/riskState"},
              "I": {"$ref": "#/$defs/riskState"}, "V": {"$ref": "#/$defs/riskState"},
              "C": {"$ref": "#/$defs/riskState"}, "U": {"$ref": "#/$defs/riskState"}
            }
          },
          "provenance": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
          "required_evidence": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
          "falsifier": {"type": "string", "minLength": 3},
          "closure_condition": {"type": "string", "minLength": 3},
          "mitigations": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 3}},
          "forbidden_promotions": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 3}},
          "dependencies": {"type": "array", "items": {"type": "string", "minLength": 1}},
          "claim_target": {"enum": ["NONE","OBSERVATION","EVIDENCED_OBSERVATION","BOUNDED_CLAIM","PRECISE_CLAIM","GENERAL_CLAIM"]},
          "next_on_pass": {"type": ["string","null"]},
          "next_on_fail": {"type": ["string","null"]}
        }
      }
    },
    "continuous_loop": {
      "type": "object", "additionalProperties": false,
      "required": ["on_every_transition","selection_rule","promotion_rule","regression_rule"],
      "properties": {
        "on_every_transition": {"type": "array", "minItems": 4, "items": {"type": "string", "minLength": 3}},
        "selection_rule": {"type": "string", "minLength": 3},
        "promotion_rule": {"type": "string", "minLength": 3},
        "regression_rule": {"type": "string", "minLength": 3}
      }
    }
  },
  "$defs": {
    "riskState": {"enum": ["CONTROLLED","WATCH","P1","P0","NOT_APPLICABLE_WITH_EVIDENCE","TOKEN_VAZIO"]}
  }
}
