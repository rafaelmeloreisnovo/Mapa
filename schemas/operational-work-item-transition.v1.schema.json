{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://github.com/rafaelmeloreisnovo/Mapa/schemas/operational-work-item-transition.v1.schema.json",
  "title":"RAFAELIA Operational Work-Item Transition v1",
  "type":"object",
  "additionalProperties":false,
  "required":["schema_version","event_id","event_type","work_item_id","observed_at","source_refs","prior_event_id","from_state","to_state","reason_code","evidence_refs","claim_allowed"],
  "properties":{
    "schema_version":{"const":"rafaelia.operational-work-item-transition/v1"},
    "event_id":{"type":"string","pattern":"^WIE-[A-Z0-9][A-Z0-9._:-]{3,127}$"},
    "event_type":{"enum":["CREATE","TRANSITION","CORRECTION","SUPERSEDE"]},
    "work_item_id":{"type":"string","pattern":"^WI-[A-Z0-9][A-Z0-9._:-]{3,95}$"},
    "observed_at":{"type":"string","format":"date-time"},
    "source_refs":{"type":"array","minItems":1,"uniqueItems":true,"items":{"type":"string","minLength":1}},
    "prior_event_id":{"anyOf":[{"const":"TOKEN_VAZIO"},{"type":"string","pattern":"^WIE-[A-Z0-9][A-Z0-9._:-]{3,127}$"}]},
    "from_state":{"anyOf":[{"type":"null"},{"$ref":"#/$defs/state"}]},
    "to_state":{"$ref":"#/$defs/state"},
    "reason_code":{"type":"string","minLength":3,"maxLength":160},
    "evidence_refs":{"type":"array","uniqueItems":true,"items":{"type":"string","minLength":1}},
    "claim_allowed":{"const":false}
  },
  "$defs":{
    "state":{
      "type":"object",
      "additionalProperties":false,
      "required":["attention","epistemic","provenance","contract","execution","closure"],
      "properties":{
        "attention":{"enum":["ACTIVE","FORGOTTEN_RECOVERED","IGNORED_INTENTIONAL","IGNORED_UNRESOLVED","DEFERRED","LEFT_INCOMPLETE","ABORTED","BLOCKED_BY_CONTROL","SUPPRESSED_BY_POLICY","SUPERSEDED","COMPLETED"]},
        "epistemic":{"enum":["VERIFIED","EVIDENCED","HYPOTHESIS","MODEL_ANALOGICAL","SYMBOLIC","TOKEN_VAZIO","ABSENT","CONFLICTING","INVALIDATED","SUPERSEDED"]},
        "provenance":{"enum":["BOUND","PARTIAL","MISSING","CONFLICTING"]},
        "contract":{"enum":["SATISFIED","PARTIAL","UNSATISFIED","BREACHED","TOKEN_VAZIO","NOT_APPLICABLE"]},
        "execution":{"enum":["NOT_STARTED","PLANNED","IN_PROGRESS","BLOCKED","EXECUTED","VERIFIED","FAILED","ABORTED","DEFERRED"]},
        "closure":{"enum":["OPEN","PARTIAL","CLOSED","TOKEN_VAZIO"]}
      }
    }
  }
}
