{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rafaelia.local/schemas/invariant-of-invariants-omega.v1.schema.json",
  "title": "RAFAELIA Invariant of Invariants Omega V1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "architecture_id",
    "as_of",
    "state",
    "claim_allowed",
    "privacy_default",
    "core_equation",
    "axes",
    "invariants",
    "surfaces",
    "relations",
    "symbols",
    "topologies",
    "methodologies",
    "freshness_contract",
    "query_contract",
    "latency_receipts",
    "gates",
    "gaps"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "architecture_id": {
      "type": "string",
      "pattern": "^IOMEGA-[A-Z0-9_-]+$"
    },
    "as_of": {
      "type": "string",
      "format": "date-time"
    },
    "state": {
      "enum": [
        "CANONICAL_CANDIDATE",
        "VERIFIED_LIMITED",
        "TOKEN_VAZIO",
        "REFUTED"
      ]
    },
    "claim_allowed": {
      "const": false
    },
    "privacy_default": {
      "const": "DENY"
    },
    "core_equation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["expression", "zero_rule"],
      "properties": {
        "expression": {
          "type": "string",
          "minLength": 1
        },
        "zero_rule": {
          "const": "TOKEN_VAZIO"
        }
      }
    },
    "axes": {
      "type": "array",
      "minItems": 8,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[A-Z][A-Z0-9_]*$"
      }
    },
    "invariants": {
      "type": "array",
      "minItems": 8,
      "items": {
        "$ref": "#/$defs/invariant"
      }
    },
    "surfaces": {
      "type": "array",
      "minItems": 8,
      "items": {
        "$ref": "#/$defs/surface"
      }
    },
    "relations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/relation"
      }
    },
    "symbols": {
      "type": "array",
      "minItems": 16,
      "items": {
        "$ref": "#/$defs/symbol"
      }
    },
    "topologies": {
      "type": "array",
      "minItems": 30,
      "items": {
        "$ref": "#/$defs/catalog_item"
      }
    },
    "methodologies": {
      "type": "array",
      "minItems": 56,
      "items": {
        "$ref": "#/$defs/catalog_item"
      }
    },
    "freshness_contract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "comparison_scope",
        "vector",
        "promotion_requires",
        "timestamp_only_forbidden",
        "conflict_state"
      ],
      "properties": {
        "comparison_scope": {
          "const": "SAME_LOGICAL_IDENTITY"
        },
        "vector": {
          "type": "array",
          "minItems": 6,
          "uniqueItems": true,
          "items": {
            "type": "string"
          }
        },
        "promotion_requires": {
          "type": "array",
          "minItems": 3,
          "uniqueItems": true,
          "items": {
            "type": "string"
          }
        },
        "timestamp_only_forbidden": {
          "const": true
        },
        "conflict_state": {
          "const": "TOKEN_VAZIO"
        }
      }
    },
    "query_contract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "grammar",
        "max_depth",
        "max_limit",
        "max_predicates",
        "timeout_ms",
        "allow_arbitrary_eval"
      ],
      "properties": {
        "grammar": {
          "type": "string",
          "minLength": 1
        },
        "max_depth": {
          "type": "integer",
          "minimum": 0,
          "maximum": 16
        },
        "max_limit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000
        },
        "max_predicates": {
          "type": "integer",
          "minimum": 1,
          "maximum": 64
        },
        "timeout_ms": {
          "type": "integer",
          "minimum": 1,
          "maximum": 60000
        },
        "allow_arbitrary_eval": {
          "const": false
        }
      }
    },
    "latency_receipts": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/latency"
      }
    },
    "gates": {
      "type": "array",
      "minItems": 8,
      "items": {
        "$ref": "#/$defs/gate"
      }
    },
    "gaps": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/gap"
      }
    }
  },
  "$defs": {
    "invariant": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "factor", "failure_state"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^I[0-9]{2}$"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "factor": {
          "type": "string",
          "minLength": 1
        },
        "failure_state": {
          "const": "TOKEN_VAZIO"
        }
      }
    },
    "surface": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "kind",
        "authority_role",
        "locator",
        "state",
        "privacy_class"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^S-[A-Z0-9_-]+$"
        },
        "kind": {
          "enum": [
            "INSTRUCTION",
            "MEMORY",
            "LIBRARY",
            "GOOGLE_DRIVE",
            "GMAIL",
            "GITHUB",
            "IMAGE",
            "PET",
            "RUNTIME",
            "SCIENCE"
          ]
        },
        "authority_role": {
          "enum": [
            "CONTROL",
            "RECONSTRUCTION",
            "CUSTODY",
            "EDITORIAL_SOURCE",
            "EVENT_PROVENANCE",
            "ONTOLOGY",
            "EXECUTION",
            "CREATIVE_ASSET",
            "UX_STATE",
            "RUNTIME",
            "SCIENTIFIC_EVIDENCE"
          ]
        },
        "locator": {
          "type": "string",
          "minLength": 1
        },
        "state": {
          "enum": [
            "CANONICAL",
            "OBSERVED",
            "OBSERVED_LIMITED",
            "IMPLEMENTED",
            "REFERENCE",
            "TOKEN_VAZIO",
            "HISTORICAL"
          ]
        },
        "privacy_class": {
          "enum": ["P0_PUBLIC", "P1_INTERNAL", "P2_PRIVATE_METADATA", "P3_PRIVATE_BODY"]
        },
        "content_hash": {
          "type": ["string", "null"]
        },
        "revision": {
          "type": ["string", "null"]
        }
      }
    },
    "relation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "from",
        "to",
        "type",
        "evidence_state",
        "receipt_locator"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^R-[A-Z0-9_-]+$"
        },
        "from": {
          "type": "string"
        },
        "to": {
          "type": "string"
        },
        "type": {
          "enum": [
            "GOVERNS",
            "RECONSTRUCTS",
            "CUSTODIES",
            "DERIVES_TO",
            "CATALOGS",
            "ROUTES",
            "NOTIFIES",
            "PERSISTS",
            "RENDERS",
            "PRESENTS",
            "EXECUTES",
            "VALIDATES",
            "FALSIFIES",
            "SUPERSEDES",
            "REFERENCES"
          ]
        },
        "evidence_state": {
          "enum": [
            "PROVADO",
            "EVIDENCIADO",
            "OBSERVADO_LIMITADO",
            "HIPOTESE",
            "MODELO_ANALOGICO",
            "REFUTADO",
            "TOKEN_VAZIO"
          ]
        },
        "receipt_locator": {
          "type": ["string", "null"]
        }
      }
    },
    "symbol": {
      "type": "object",
      "additionalProperties": false,
      "required": ["token", "operator", "evidence_weight"],
      "properties": {
        "token": {
          "type": "string",
          "minLength": 1
        },
        "operator": {
          "type": "string",
          "minLength": 1
        },
        "evidence_weight": {
          "const": 0
        }
      }
    },
    "catalog_item": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "group", "name", "gate"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[TM][0-9]{2}$"
        },
        "group": {
          "type": "string",
          "minLength": 1
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "gate": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "latency": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "scope",
        "wall_ms",
        "measured_at",
        "classification",
        "throughput"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^L[0-9]{2}$"
        },
        "scope": {
          "type": "string",
          "minLength": 1
        },
        "wall_ms": {
          "type": "integer",
          "minimum": 0
        },
        "measured_at": {
          "type": "string",
          "format": "date-time"
        },
        "classification": {
          "enum": ["MEASURED_CONFOUNDED", "MEASURED_ISOLATED", "TOKEN_VAZIO"]
        },
        "throughput": {
          "type": ["number", "string"]
        }
      }
    },
    "gate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "pass_condition", "failure_action"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^G[0-9]{2}$"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "pass_condition": {
          "type": "string",
          "minLength": 1
        },
        "failure_action": {
          "enum": ["TOKEN_VAZIO", "ROLLBACK", "QUARANTINE", "STOP"]
        }
      }
    },
    "gap": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "state", "description", "falsifier", "next_gate"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^GAP-[A-Z0-9_-]+$"
        },
        "state": {
          "const": "TOKEN_VAZIO"
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "falsifier": {
          "type": "string",
          "minLength": 1
        },
        "next_gate": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
