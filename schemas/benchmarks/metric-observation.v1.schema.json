{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rafaelia.local/schemas/benchmarks/metric-observation.v1.schema.json",
  "title": "RAFAELIA MetricObservationV1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "observation_id",
    "metric_name",
    "category",
    "value_state",
    "epistemic_class",
    "observed_value",
    "original_unit",
    "normalization",
    "scope",
    "source_refs",
    "evidence",
    "claim_allowed",
    "next_verifiable_step"
  ],
  "properties": {
    "schema": {"const": "RAFAELIA_METRIC_OBSERVATION_V1"},
    "observation_id": {"type": "string", "pattern": "^METRIC-[A-Z0-9][A-Z0-9._-]+$"},
    "observed_at": {"type": ["string", "null"]},
    "metric_name": {"type": "string", "minLength": 1},
    "category": {
      "enum": ["TIME", "RATE", "STORAGE", "BANDWIDTH", "CPU", "MEMORY", "EMULATION", "COMPUTE", "DISTRIBUTION", "INTEGRITY", "FOOTPRINT", "SCALING", "ENERGY", "OTHER"]
    },
    "value_state": {
      "enum": ["MEASURED", "HISTORICAL", "IMPLEMENTED_PATH", "DOCUMENTED_UNBOUND", "ESTIMATE", "EXPECTED_RANGE", "OPERATIONAL_THRESHOLD", "TOKEN_VAZIO"]
    },
    "epistemic_class": {
      "enum": ["MEASURED_WITH_RECEIPT", "HISTORICAL_RUN_OUTPUT", "MEASUREMENT_PATH_IMPLEMENTED", "DOCUMENTED_BENCHMARK_UNBOUND", "ESTIMATE_CODE_ANALYSIS", "EXPECTED_REFERENCE_RANGE", "OPERATIONAL_THRESHOLD", "TOKEN_VAZIO"]
    },
    "observed_value": {"type": ["number", "null"]},
    "original_unit": {"type": "string", "minLength": 1},
    "normalization": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "canonical_value", "canonical_unit", "dimension", "rule_id"],
      "properties": {
        "status": {"enum": ["NORMALIZED", "PRESERVED_SEMANTIC", "TOKEN_VAZIO"]},
        "canonical_value": {"type": ["number", "null"]},
        "canonical_unit": {"type": "string"},
        "dimension": {"type": "string"},
        "rule_id": {"type": "string"}
      }
    },
    "statistic": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "kind": {"enum": ["RAW", "BEST", "WORST", "MEAN", "MEDIAN", "TRIMMED_MEAN", "P50", "P95", "P99", "MIN", "MAX", "THRESHOLD", "UNKNOWN"]},
        "sample_count": {"type": ["integer", "null"], "minimum": 1},
        "repeats": {"type": ["integer", "null"], "minimum": 1},
        "confidence": {"type": ["number", "null"], "minimum": 0, "maximum": 1}
      }
    },
    "direction": {"enum": ["HIGHER_IS_BETTER", "LOWER_IS_BETTER", "TARGET_RANGE", "CONTEXT_DEPENDENT", "NOT_APPLICABLE"]},
    "scope": {"type": "string", "minLength": 1},
    "source_refs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": true,
        "minProperties": 1
      }
    },
    "environment": {"type": "object", "additionalProperties": true},
    "workload": {"type": "object", "additionalProperties": true},
    "config": {"type": "object", "additionalProperties": true},
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "artifact_sha256": {"type": ["string", "null"], "pattern": "^[a-fA-F0-9]{64}$"},
        "receipt_refs": {"type": "array", "items": {"type": "string"}},
        "raw_result_refs": {"type": "array", "items": {"type": "string"}},
        "digest_verified": {"type": ["boolean", "null"]}
      }
    },
    "negative_evidence": {"type": "boolean"},
    "supersedes": {"type": "array", "items": {"type": "string"}},
    "token_vazio": {"type": "array", "items": {"type": "string", "pattern": "^TOKEN_VAZIO"}},
    "promotion_gate": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "status": {"enum": ["NOT_REQUESTED", "BLOCKED", "APPROVED"]},
        "reviewer": {"type": ["string", "null"]},
        "receipt_ref": {"type": ["string", "null"]}
      }
    },
    "claim_allowed": {"type": "boolean"},
    "notes": {"type": "string"},
    "next_verifiable_step": {"type": "string", "minLength": 1}
  },
  "allOf": [
    {
      "if": {"properties": {"value_state": {"const": "TOKEN_VAZIO"}}},
      "then": {
        "properties": {
          "observed_value": {"type": "null"},
          "claim_allowed": {"const": false},
          "normalization": {
            "properties": {
              "status": {"const": "TOKEN_VAZIO"},
              "canonical_value": {"type": "null"}
            }
          }
        }
      }
    },
    {
      "if": {"properties": {"epistemic_class": {"enum": ["HISTORICAL_RUN_OUTPUT", "MEASUREMENT_PATH_IMPLEMENTED", "DOCUMENTED_BENCHMARK_UNBOUND", "ESTIMATE_CODE_ANALYSIS", "EXPECTED_REFERENCE_RANGE", "OPERATIONAL_THRESHOLD", "TOKEN_VAZIO"]}}},
      "then": {"properties": {"claim_allowed": {"const": false}}}
    }
  ]
}
