{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rafaelia.local/schemas/evidence-closure-record.v1.schema.json",
  "title": "RAFAELIA Cross-Tech Evidence Closure Record V1",
  "description": "Append-only, hash-linked record for governed closure of TOKEN_VAZIO/gaps across independent evidence axes.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "closure_id",
    "revision",
    "status",
    "claim_allowed",
    "required_axes",
    "evidence_vector",
    "uncertainty",
    "problem",
    "risk",
    "next_probe",
    "closure_rule",
    "falsifier",
    "provenance",
    "receipts",
    "dependencies",
    "contradictions",
    "previous_record_sha256",
    "transition_reason",
    "observed_at"
  ],
  "properties": {
    "schema_version": {
      "const": "evidence-closure-record.v1"
    },
    "closure_id": {
      "type": "string",
      "minLength": 6
    },
    "revision": {
      "type": "integer",
      "minimum": 0
    },
    "status": {
      "enum": [
        "TOKEN_VAZIO",
        "BLOCKED",
        "OBSERVED_LIMITED",
        "EVIDENCED",
        "CLOSED_PASS",
        "CLOSED_FAIL",
        "ARCHIVED"
      ]
    },
    "claim_allowed": {
      "type": "boolean"
    },
    "scope": {
      "type": "string",
      "minLength": 1
    },
    "owner": {
      "type": "string",
      "minLength": 1
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "required_axes": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": [
          "CODE",
          "BUILD",
          "RUNTIME",
          "TEST",
          "CI",
          "DEVICE",
          "SECURITY",
          "PROVENANCE",
          "REPRODUCIBILITY"
        ]
      },
      "contains": {
        "const": "PROVENANCE"
      }
    },
    "evidence_vector": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "CODE",
        "BUILD",
        "RUNTIME",
        "TEST",
        "CI",
        "DEVICE",
        "SECURITY",
        "PROVENANCE",
        "REPRODUCIBILITY"
      ],
      "properties": {
        "CODE": {
          "enum": ["PASS", "FAIL", "BLOCKED", "OBSERVED", "OBSERVED_LIMITED", "TOKEN_VAZIO", "NOT_APPLICABLE"]
        },
        "BUILD": {
          "enum": ["PASS", "FAIL", "BLOCKED", "OBSERVED", "OBSERVED_LIMITED", "TOKEN_VAZIO", "NOT_APPLICABLE"]
        },
        "RUNTIME": {
          "enum": ["PASS", "FAIL", "BLOCKED", "OBSERVED", "OBSERVED_LIMITED", "TOKEN_VAZIO", "NOT_APPLICABLE"]
        },
        "TEST": {
          "enum": ["PASS", "FAIL", "BLOCKED", "OBSERVED", "OBSERVED_LIMITED", "TOKEN_VAZIO", "NOT_APPLICABLE"]
        },
        "CI": {
          "enum": ["PASS", "FAIL", "BLOCKED", "OBSERVED", "OBSERVED_LIMITED", "TOKEN_VAZIO", "NOT_APPLICABLE"]
        },
        "DEVICE": {
          "enum": ["PASS", "FAIL", "BLOCKED", "OBSERVED", "OBSERVED_LIMITED", "TOKEN_VAZIO", "NOT_APPLICABLE"]
        },
        "SECURITY": {
          "enum": ["PASS", "FAIL", "BLOCKED", "OBSERVED", "OBSERVED_LIMITED", "TOKEN_VAZIO", "NOT_APPLICABLE"]
        },
        "PROVENANCE": {
          "enum": ["PASS", "FAIL", "BLOCKED", "OBSERVED", "OBSERVED_LIMITED", "TOKEN_VAZIO", "NOT_APPLICABLE"]
        },
        "REPRODUCIBILITY": {
          "enum": ["PASS", "FAIL", "BLOCKED", "OBSERVED", "OBSERVED_LIMITED", "TOKEN_VAZIO", "NOT_APPLICABLE"]
        }
      }
    },
    "uncertainty": {
      "type": "object",
      "additionalProperties": false,
      "required": ["class", "reasons"],
      "properties": {
        "class": {
          "enum": ["MEASURED", "BOUNDED", "TOKEN_VAZIO", "BLOCKED"]
        },
        "reasons": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "problem": {
      "type": "string",
      "minLength": 3
    },
    "risk": {
      "type": "string",
      "minLength": 3
    },
    "next_probe": {
      "type": "string",
      "minLength": 3
    },
    "closure_rule": {
      "type": "string",
      "minLength": 3
    },
    "falsifier": {
      "type": "string",
      "minLength": 3
    },
    "provenance": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["kind", "locator", "authority"],
        "properties": {
          "kind": {
            "enum": ["github", "drive_private_sanitized", "receipt", "other"]
          },
          "locator": {
            "type": "string",
            "minLength": 1
          },
          "authority": {
            "enum": ["OBSERVED", "SOURCE_REPORTED", "PUBLIC_RECEIPT", "BYTE_HASHED", "BYTE_PARSED", "COMMIT_PINNED"]
          },
          "commit_sha": {
            "type": ["string", "null"],
            "pattern": "^[A-Fa-f0-9]{40}$"
          },
          "sha256": {
            "type": ["string", "null"],
            "pattern": "^[A-Fa-f0-9]{64}$"
          }
        }
      }
    },
    "receipts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["locator", "sha256", "producer", "observed_at"],
        "properties": {
          "locator": {
            "type": "string",
            "minLength": 1
          },
          "sha256": {
            "type": "string",
            "pattern": "^[A-Fa-f0-9]{64}$"
          },
          "producer": {
            "type": "string",
            "minLength": 1
          },
          "observed_at": {
            "type": "string",
            "format": "date-time"
          }
        }
      }
    },
    "dependencies": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["closure_id", "state", "locator"],
        "properties": {
          "closure_id": {
            "type": "string",
            "minLength": 1
          },
          "state": {
            "enum": ["TOKEN_VAZIO", "BLOCKED", "OBSERVED_LIMITED", "EVIDENCED", "CLOSED_PASS", "CLOSED_FAIL", "ARCHIVED", "NOT_APPLICABLE"]
          },
          "locator": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "contradictions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "lhs", "rhs", "state", "resolution_evidence"],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "lhs": {
            "type": "string",
            "minLength": 1
          },
          "rhs": {
            "type": "string",
            "minLength": 1
          },
          "state": {
            "enum": ["OPEN", "RESOLVED"]
          },
          "resolution_evidence": {
            "type": ["string", "null"]
          }
        }
      }
    },
    "previous_record_sha256": {
      "type": ["string", "null"],
      "pattern": "^[A-Fa-f0-9]{64}$"
    },
    "transition_reason": {
      "type": "string",
      "minLength": 3
    },
    "observed_at": {
      "type": "string",
      "format": "date-time"
    }
  }
}
