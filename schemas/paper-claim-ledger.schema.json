{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rafaelia.example/schemas/paper-claim-ledger.schema.json",
  "title": "RAFAELIA Paper Claim Ledger Record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "claim_id",
    "statement",
    "claim_type",
    "ink",
    "state",
    "source_refs",
    "evidence_refs",
    "falsifiers",
    "limitations",
    "privacy_class",
    "license_or_authorization",
    "claim_allowed"
  ],
  "properties": {
    "schema": {
      "const": "rafaelia.paper-claim-ledger.v1"
    },
    "claim_id": {
      "type": "string",
      "pattern": "^CLM-[A-Z0-9][A-Z0-9._-]{2,63}$"
    },
    "statement": {
      "type": "string",
      "minLength": 10
    },
    "claim_type": {
      "enum": [
        "MATHEMATICS",
        "CODE",
        "SCIENCE",
        "SYMBOLIC",
        "LEGAL",
        "GOVERNANCE"
      ]
    },
    "ink": {
      "enum": [
        "DEMONSTRATION",
        "CONVENTION",
        "HYPOTHESIS",
        "PARABLE",
        "TOKEN_VAZIO"
      ]
    },
    "state": {
      "enum": [
        "PASS",
        "FAIL",
        "DRAFT",
        "TOKEN_VAZIO",
        "BLOCKED",
        "DISPUTED",
        "REJECTED"
      ]
    },
    "source_refs": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "evidence_refs": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "falsifiers": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 3
      }
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 3
      }
    },
    "privacy_class": {
      "enum": [
        "PUBLIC",
        "AUTHORIZED_PRIVATE",
        "PRIVATE_RESTRICTED",
        "SENSITIVE_EXCLUDED"
      ]
    },
    "license_or_authorization": {
      "type": "string",
      "minLength": 1
    },
    "claim_allowed": {
      "type": "boolean"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "claim_allowed": {
            "const": true
          }
        },
        "required": [
          "claim_allowed"
        ]
      },
      "then": {
        "properties": {
          "ink": {
            "enum": [
              "DEMONSTRATION",
              "CONVENTION",
              "HYPOTHESIS"
            ]
          },
          "state": {
            "const": "PASS"
          },
          "evidence_refs": {
            "minItems": 1
          },
          "falsifiers": {
            "minItems": 1
          },
          "limitations": {
            "minItems": 1
          },
          "privacy_class": {
            "enum": [
              "PUBLIC",
              "AUTHORIZED_PRIVATE"
            ]
          },
          "license_or_authorization": {
            "not": {
              "const": "TOKEN_VAZIO"
            }
          }
        }
      }
    }
  ]
}
