{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rafaelia.local/schemas/sustento-t-observation-gate.schema.json",
  "title": "RAFAELIA SUSTENTO^T observation receipt",
  "type": "object",
  "required": [
    "schema",
    "state",
    "claim_allowed",
    "promotion_allowed",
    "boundary",
    "model",
    "gate",
    "noise_sweep",
    "geometry",
    "receipt_sha256"
  ],
  "properties": {
    "schema": {"const": "rafaelia.sustento-t-observation.receipt.v1"},
    "state": {"type": "string"},
    "claim_allowed": {"const": false},
    "promotion_allowed": {"const": false},
    "boundary": {"const": "SOURCE!=ARTEFACT!=EXECUTION!=EVIDENCE!=CLAIM"},
    "model": {"type": "object"},
    "gate": {
      "type": "object",
      "required": ["state", "tau", "pass"],
      "properties": {
        "state": {"type": "string"},
        "score": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
        "tau": {"type": "number", "minimum": 0, "maximum": 1},
        "pass": {"type": "boolean"},
        "effective": {"type": ["object", "null"]}
      }
    },
    "noise_sweep": {"type": "array", "minItems": 1},
    "geometry": {"type": "object"},
    "receipt_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  },
  "additionalProperties": true
}
