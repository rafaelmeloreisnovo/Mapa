{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rafaelia.example/schemas/multimodal-transform.v1.schema.json",
  "title": "RAFAELIA multimodal transform v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "transform_id",
    "kind",
    "state",
    "scope",
    "input_representation_ids",
    "output_representation_ids",
    "reversibility",
    "invariants",
    "loss_accounting",
    "evidence",
    "claim_allowed"
  ],
  "properties": {
    "transform_id": {"type": "string", "pattern": "^MMX-[A-Z0-9-]+$"},
    "kind": {
      "enum": [
        "METADATA_INSPECTION",
        "BITPLANE_SPLIT",
        "FORMAT_TRANSCODE",
        "ROTATION",
        "ALPHA_OVERLAY",
        "FOLD_PROJECTION",
        "TILE_PYRAMID"
      ]
    },
    "state": {"enum": ["VERIFIED_LIMITED", "REFERENCE", "TOKEN_VAZIO_EXECUTION"]},
    "scope": {"type": "string", "minLength": 3},
    "input_representation_ids": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^MMR-"}
    },
    "output_representation_ids": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^MMR-"}
    },
    "reversibility": {"enum": ["EXACT", "EXACT_NO_MUTATION", "CONDITIONAL", "NO", "TOKEN_VAZIO"]},
    "parameters": {"type": "object"},
    "invariants": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "loss_accounting": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["class", "gate", "result"],
      "properties": {
        "class": {"enum": ["MEASURED_LOCAL", "REFERENCE_ONLY", "TOKEN_VAZIO"]},
        "gate": {"type": "string"},
        "result": {"enum": ["PASS", "NOT_EXECUTED", "TOKEN_VAZIO"]}
      }
    },
    "claim_allowed": {"const": false}
  }
}
