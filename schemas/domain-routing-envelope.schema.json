{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rafaelia.example/schemas/domain-routing-envelope.v1.schema.json",
  "title": "RAFAELIA Domain Routing Envelope V1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "routing_id", "vector", "claims", "cross_domain_promotion_allowed", "semantic_domain_inference_allowed", "claim_allowed"],
  "properties": {
    "schema": {"const": "rafaelia.domain-routing-envelope/v1"},
    "routing_id": {"type": "string", "minLength": 3},
    "vector": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "canonical_sha256", "vector_id", "revision"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "vector_id": {"type": "string", "minLength": 3},
        "revision": {"type": "integer", "minimum": 1},
        "canonical_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
      }
    },
    "claims": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["claim_id", "claim_type", "declared_domain", "input_state", "source_refs", "requested_transition", "claim_allowed"],
        "properties": {
          "claim_id": {"type": "string", "minLength": 3},
          "claim_type": {"type": "string", "minLength": 3},
          "declared_domain": {"enum": ["COMPUTATIONAL", "SCIENTIFIC", "LEGAL", "ETHICAL"]},
          "input_state": {"type": "string", "minLength": 3},
          "source_refs": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
          "requested_transition": {"const": "READY_FOR_DOMAIN_SPECIFIC_REVIEW"},
          "claim_allowed": {"const": false}
        }
      }
    },
    "cross_domain_promotion_allowed": {"const": false},
    "semantic_domain_inference_allowed": {"const": false},
    "claim_allowed": {"const": false}
  }
}
