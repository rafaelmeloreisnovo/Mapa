{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rafaelia.local/schemas/knowledge-work-house.v1.schema.json",
  "title": "RAFAELIA Knowledge Work House Unit V1",
  "type": "object",
  "required": [
    "id","intent","authority","sources","context","evidence",
    "contradictions","uncertainty","reproduction","rollback",
    "reconstructibility","state","claim_allowed","next"
  ],
  "properties": {
    "id": {"type":"string","minLength":1},
    "intent": {"type":"string","minLength":1},
    "authority": {"type":"string","minLength":1},
    "sources": {
      "type":"array","minItems":1,
      "items":{"type":"object","required":["ref","kind"],"properties":{
        "ref":{"type":"string","minLength":1},
        "kind":{"type":"string","enum":["SOURCE","INDEX","MEMORY","DATASET","CODE","DOCUMENT","RUNTIME","OTHER"]},
        "hash":{"type":["string","null"]}
      }}
    },
    "context": {
      "type":"object",
      "required":["scope","boundary","observed_at"],
      "properties":{
        "scope":{"type":"string","minLength":1},
        "boundary":{"type":"string","minLength":1},
        "observed_at":{"type":"string","minLength":1},
        "dependencies":{"type":"array","items":{"type":"string"}}
      }
    },
    "artifact_refs":{"type":"array","items":{"type":"string"}},
    "execution_refs":{"type":"array","items":{"type":"string"}},
    "evidence":{"type":"array","items":{"type":"object","required":["ref","type"],"properties":{
      "ref":{"type":"string","minLength":1},
      "type":{"type":"string","enum":["TEST","RUN","HASH","DATA","RECEIPT","REVIEW","NEGATIVE_RESULT","OTHER"]}
    }}},
    "contradictions":{"type":"array","items":{"type":"object","required":["id","state"],"properties":{
      "id":{"type":"string","minLength":1},
      "state":{"type":"string","enum":["OPEN","RESOLVED","SUPERSEDED"]},
      "ref":{"type":["string","null"]}
    }}},
    "uncertainty":{"type":"array","items":{"type":"object","required":["id","state"],"properties":{
      "id":{"type":"string","minLength":1},
      "state":{"type":"string","enum":["TOKEN_VAZIO","BLOCKED","PARTIAL","NOT_APPLICABLE","CLOSED"]},
      "needed":{"type":["string","null"]}
    }}},
    "reproduction":{"type":"object","required":["status","procedure"],"properties":{
      "status":{"type":"string","enum":["TOKEN_VAZIO","BLOCKED","PASS","FAIL","NOT_APPLICABLE"]},
      "procedure":{"type":"string"},
      "environment_ref":{"type":["string","null"]}
    }},
    "rollback":{"type":"object","required":["ready","predecessor"],"properties":{
      "ready":{"type":"boolean"},
      "predecessor":{"type":["string","null"]},
      "procedure":{"type":["string","null"]}
    }},
    "reconstructibility":{"type":"object","required":["status","inputs_pinned","versions_pinned","outputs_identified"],"properties":{
      "status":{"type":"string","enum":["TOKEN_VAZIO","BLOCKED","PASS","FAIL"]},
      "inputs_pinned":{"type":"boolean"},
      "versions_pinned":{"type":"boolean"},
      "outputs_identified":{"type":"boolean"}
    }},
    "state":{"type":"string","enum":["DRAFT","TOKEN_VAZIO","BLOCKED","CONTRADICTION","VERIFIED_LIMITED","REPRODUCED","ROLLBACK_READY","CLOSED"]},
    "claim_allowed":{"type":"boolean"},
    "next":{"type":"string","minLength":1}
  },
  "additionalProperties": false
}
