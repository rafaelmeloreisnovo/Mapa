{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rafaelia.local/schemas/gap-closure-manifest.schema.json",
  "title": "RAFAELIA Gap Closure Manifest",
  "type": "object",
  "required": ["schema", "wave_id", "claim_allowed"],
  "properties": {
    "schema": {"type": "string", "minLength": 1},
    "wave_id": {"type": "string", "minLength": 1},
    "repository": {"type": "string"},
    "status": {"type": "string"},
    "claim_allowed": {"type": "boolean", "const": false},
    "gaps": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "class", "state"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "class": {"type": "string", "minLength": 1},
          "state": {
            "type": "string",
            "enum": ["OBSERVED", "WIRED", "BUILD_PROVEN", "RUNTIME_PROVEN", "DEVICE_PROVEN", "REPRODUCED", "TOKEN_VAZIO", "BLOCKED", "FALSIFIED", "CLOSED"]
          },
          "producer": {"type": "string"},
          "next_gate": {"type": "string"},
          "required_evidence": {"type": "array", "items": {"type": "string"}}
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
