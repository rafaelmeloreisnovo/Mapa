{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rafaelia.local/schemas/session-semantic-ledger.v1.schema.json",
  "title": "RAFAELIA Session Semantic Ledger V1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "event_id", "timestamp_local", "mode", "claim_allowed",
    "scope", "forests", "concepts", "sessions", "relations", "invariants",
    "coverage", "F_ok", "F_gap", "F_next"
  ],
  "properties": {
    "schema_version": {"const": "rafaelia.session-semantic-ledger/v1"},
    "event_id": {"type": "string", "minLength": 8},
    "timestamp_local": {"type": "string", "format": "date-time"},
    "mode": {
      "type": "array",
      "minItems": 4,
      "items": {"enum": ["append-only", "non-destructive", "fail-closed", "provenance-first", "semantic-blocks", "typed-token-vazio", "claim-gate-false"]}
    },
    "claim_allowed": {"const": false},
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["project", "surface", "observed_session_count", "provider_ids_resolved", "source_limitation"],
      "properties": {
        "project": {"type": "string", "minLength": 1},
        "surface": {"type": "string", "minLength": 1},
        "observed_session_count": {"type": "integer", "minimum": 1},
        "provider_ids_resolved": {"type": "integer", "minimum": 0},
        "source_limitation": {"type": "string", "minLength": 1}
      }
    },
    "forests": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["forest_id", "label", "function"],
        "properties": {
          "forest_id": {"type": "string", "pattern": "^F[1-7]_[A-Z0-9_]+$"},
          "label": {"type": "string", "minLength": 1},
          "function": {"type": "string", "minLength": 1}
        }
      }
    },
    "concepts": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["concept_id", "label", "definition", "layer", "classification", "claim_allowed"],
        "properties": {
          "concept_id": {"type": "string", "pattern": "^concept:[a-z0-9:_-]+$"},
          "label": {"type": "string", "minLength": 1},
          "definition": {"type": "string", "minLength": 1},
          "layer": {"enum": ["literal", "technical", "mathematical", "statistical", "historical", "scientific", "symbolic", "ethical", "operational", "governance"]},
          "classification": {"enum": ["EXACT", "CONVENTION", "HYPOTHESIS", "PARABLE", "OPERATIONAL", "TOKEN_VAZIO"]},
          "claim_allowed": {"const": false}
        }
      }
    },
    "sessions": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": [
          "session_id", "observed_timestamp", "observed_title", "source_locator",
          "provider_id", "source_state", "ordinal_sequence", "primary_forest",
          "secondary_forests", "intent", "semantic_tokens", "semantic_blocks",
          "concept_refs", "epistemic_state", "claim_allowed", "gaps"
        ],
        "properties": {
          "session_id": {"type": "string", "pattern": "^session:[0-9]{8}t[0-9]{4}:[a-z0-9_-]+$"},
          "observed_timestamp": {"type": "string", "format": "date-time"},
          "observed_title": {"type": "string", "minLength": 1},
          "source_locator": {"type": "string", "minLength": 1},
          "provider_id": {"type": ["string", "null"]},
          "source_state": {"enum": ["OBSERVED_CONTEXT_PROVIDER_ID_UNAVAILABLE", "VERIFIED_PROVIDER_ID", "OBSERVED_EXPORT", "TOKEN_VAZIO_SOURCE"]},
          "ordinal_sequence": {"type": "integer", "minimum": 1},
          "primary_forest": {"type": "string"},
          "secondary_forests": {"type": "array", "items": {"type": "string"}},
          "intent": {"type": "string", "minLength": 1},
          "semantic_tokens": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
          "semantic_blocks": {
            "type": "array", "minItems": 1,
            "items": {
              "type": "object", "additionalProperties": false,
              "required": ["block_id", "kind", "summary", "concept_refs", "state"],
              "properties": {
                "block_id": {"type": "string", "minLength": 3},
                "kind": {"enum": ["INTENT", "STRUCTURE", "EVIDENCE", "IMPLEMENTATION", "GAP", "DECISION", "PARABLE"]},
                "summary": {"type": "string", "minLength": 1},
                "concept_refs": {"type": "array", "items": {"type": "string"}},
                "state": {"enum": ["OBSERVED", "DERIVED_INTERPRETATION", "TOKEN_VAZIO"]}
              }
            }
          },
          "concept_refs": {"type": "array", "minItems": 1, "items": {"type": "string"}},
          "epistemic_state": {"enum": ["EVIDENCIADO_METADATA", "DERIVED_INTERPRETATION", "TOKEN_VAZIO"]},
          "claim_allowed": {"const": false},
          "gaps": {
            "type": "array",
            "items": {
              "type": "object", "additionalProperties": false,
              "required": ["gap_id", "gap_class", "reason", "expected_evidence", "closure_test", "priority", "blocking"],
              "properties": {
                "gap_id": {"type": "string", "minLength": 3},
                "gap_class": {"enum": ["TV-DEF", "TV-SOURCE", "TV-ACCESS", "TV-DATA", "TV-BOUNDARY", "TV-CODE", "TV-TEST", "TV-ENV", "TV-INDEPENDENCE", "TV-IRREDUCIBLE"]},
                "reason": {"type": "string", "minLength": 1},
                "expected_evidence": {"type": "string", "minLength": 1},
                "closure_test": {"type": "string", "minLength": 1},
                "priority": {"enum": ["P0", "P1", "P2", "P3", "P4"]},
                "blocking": {"type": "boolean"}
              }
            }
          }
        }
      }
    },
    "relations": {
      "type": "array",
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["relation_id", "subject", "predicate", "object", "state", "confidence", "basis"],
        "properties": {
          "relation_id": {"type": "string", "minLength": 3},
          "subject": {"type": "string", "minLength": 1},
          "predicate": {"enum": ["DERIVES_FROM", "DEPENDS_ON", "SUPPORTS", "CONTRADICTS", "SUPERSEDES", "IMPLEMENTS", "VALIDATES", "BLOCKS", "PRODUCES", "MENTIONS", "CROSS_LINK"]},
          "object": {"type": "string", "minLength": 1},
          "state": {"enum": ["OBSERVED", "DERIVED_INTERPRETATION", "TOKEN_VAZIO"]},
          "confidence": {"type": "number", "minimum": 0, "maximum": 1},
          "basis": {"type": "string", "minLength": 1}
        }
      }
    },
    "invariants": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "coverage": {
      "type": "object", "additionalProperties": false,
      "required": ["sessions", "semantic_blocks", "concepts", "relations", "typed_gaps", "provider_id_gaps", "claim_allowed_true"],
      "properties": {
        "sessions": {"type": "integer", "minimum": 0},
        "semantic_blocks": {"type": "integer", "minimum": 0},
        "concepts": {"type": "integer", "minimum": 0},
        "relations": {"type": "integer", "minimum": 0},
        "typed_gaps": {"type": "integer", "minimum": 0},
        "provider_id_gaps": {"type": "integer", "minimum": 0},
        "claim_allowed_true": {"const": 0}
      }
    },
    "F_ok": {"type": "array", "items": {"type": "string"}},
    "F_gap": {"type": "array", "items": {"type": "string"}},
    "F_next": {"type": "array", "minItems": 1, "items": {"type": "string"}}
  }
}
