{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rafaelia.invalid/schemas/operational-triage.schema.json",
  "title": "RAFAELIA Operational Triage and Equivalence",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "registry_id", "claim_allowed", "policy", "items", "groups", "relations", "next_verifiable_step"],
  "properties": {
    "schema_version": {"const": "rafaelia.operational-triage/v1"},
    "registry_id": {"type": "string", "pattern": "^triage:[A-Za-z0-9._:-]{6,127}$"},
    "claim_allowed": {"const": false},
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["token_vazio_is_valid", "exact_equivalence_requires_evidence", "human_safety_precedes_performance", "privacy_precedes_interpretation"],
      "properties": {
        "token_vazio_is_valid": {"const": true},
        "exact_equivalence_requires_evidence": {"const": true},
        "human_safety_precedes_performance": {"const": true},
        "privacy_precedes_interpretation": {"const": true}
      }
    },
    "items": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/item"}},
    "groups": {"type": "array", "items": {"$ref": "#/$defs/group"}},
    "relations": {"type": "array", "items": {"$ref": "#/$defs/relation"}},
    "next_verifiable_step": {"type": "string", "minLength": 1}
  },
  "$defs": {
    "score_vector": {
      "type": "object",
      "additionalProperties": false,
      "required": ["human_safety", "privacy_integrity", "operational_impact", "dependency_blocking", "risk_of_delay", "evidence_deficit", "reversibility"],
      "properties": {
        "human_safety": {"type": "integer", "minimum": 0, "maximum": 5},
        "privacy_integrity": {"type": "integer", "minimum": 0, "maximum": 5},
        "operational_impact": {"type": "integer", "minimum": 0, "maximum": 5},
        "dependency_blocking": {"type": "integer", "minimum": 0, "maximum": 5},
        "risk_of_delay": {"type": "integer", "minimum": 0, "maximum": 5},
        "evidence_deficit": {"type": "integer", "minimum": 0, "maximum": 5},
        "reversibility": {"type": "integer", "minimum": 0, "maximum": 5}
      }
    },
    "invariant": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "statement", "state", "evidence_refs"],
      "properties": {
        "id": {"type": "string", "pattern": "^INV-[A-Z0-9_-]{3,64}$"},
        "statement": {"type": "string", "minLength": 1},
        "state": {"enum": ["SATISFIED", "VIOLATED", "TOKEN_VAZIO", "NOT_APPLICABLE"]},
        "evidence_refs": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true}
      }
    },
    "item": {
      "type": "object",
      "additionalProperties": false,
      "required": ["item_id", "title", "domain", "object_type", "target", "data_class", "epistemic_state", "privacy_class", "status", "score_vector", "declared_priority", "invariants", "dependencies", "evidence_refs", "next_action", "rollback"],
      "properties": {
        "item_id": {"type": "string", "pattern": "^ITM-[0-9]{3,6}$"},
        "title": {"type": "string", "minLength": 1},
        "domain": {"type": "string", "minLength": 1},
        "object_type": {"enum": ["DATA", "CODE", "WORKFLOW", "CLAIM", "POLICY", "RUNTIME", "INDEX", "ARTIFACT", "RELATION"]},
        "target": {"type": "string", "minLength": 1},
        "data_class": {"enum": ["NECESSITY", "REQUIRED", "URGENT", "RISK", "GAP", "EVIDENCE", "ACTION"]},
        "epistemic_state": {"enum": ["FATO", "VERIFIED_LIMITED", "HIPOTESE", "CONTRADICTION", "TOKEN_VAZIO"]},
        "privacy_class": {"enum": ["PUBLIC", "PRIVATE", "RESTRICTED", "EXCLUDED"]},
        "status": {"enum": ["OBSERVED", "CLASSIFIED", "GROUPED", "READY", "BLOCKED", "IN_PROGRESS", "VERIFIED", "CLOSED", "TOKEN_VAZIO"]},
        "score_vector": {"$ref": "#/$defs/score_vector"},
        "declared_priority": {"enum": ["P0_CRITICAL", "P1_URGENT", "P2_NECESSARY", "P3_IMPORTANT", "P4_BACKLOG"]},
        "invariants": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/invariant"}},
        "dependencies": {"type": "array", "items": {"type": "string", "pattern": "^ITM-[0-9]{3,6}$"}, "uniqueItems": true},
        "evidence_refs": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
        "next_action": {"type": "string", "minLength": 1},
        "rollback": {"type": "string", "minLength": 1}
      }
    },
    "group": {
      "type": "object",
      "additionalProperties": false,
      "required": ["group_id", "label", "basis", "members", "invariant_signature", "claim_allowed"],
      "properties": {
        "group_id": {"type": "string", "pattern": "^GRP-[A-Z0-9_-]{3,64}$"},
        "label": {"type": "string", "minLength": 1},
        "basis": {"enum": ["DOMAIN", "TARGET", "INVARIANT_SIGNATURE", "DEPENDENCY_CHAIN", "RISK_CLASS", "PRIVACY_CLASS"]},
        "members": {"type": "array", "minItems": 1, "items": {"type": "string", "pattern": "^ITM-[0-9]{3,6}$"}, "uniqueItems": true},
        "invariant_signature": {"type": "array", "items": {"type": "string", "pattern": "^INV-[A-Z0-9_-]{3,64}$"}, "uniqueItems": true},
        "claim_allowed": {"const": false}
      }
    },
    "relation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["relation_id", "left", "right", "relation_type", "evidence_refs", "reason", "claim_allowed"],
      "properties": {
        "relation_id": {"type": "string", "pattern": "^REL-[0-9]{3,6}$"},
        "left": {"type": "string", "pattern": "^ITM-[0-9]{3,6}$"},
        "right": {"type": "string", "pattern": "^ITM-[0-9]{3,6}$"},
        "relation_type": {"enum": ["SAME_SITUATION", "STRUCTURAL_ANALOG", "DEPENDENT", "PART_OF", "CONFLICTS_WITH", "SUPERSEDES", "DISTINCT", "TOKEN_VAZIO"]},
        "evidence_refs": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
        "reason": {"type": "string", "minLength": 1},
        "claim_allowed": {"const": false}
      }
    }
  }
}
