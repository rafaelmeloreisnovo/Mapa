{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rafaelia.local/schemas/federation-state-v1.schema.json",
  "title": "RAFAELIA Federation State V1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "snapshot_id",
    "observed_at",
    "control_plane",
    "state",
    "claim_allowed",
    "receipt_contract",
    "nodes",
    "gaps",
    "F_ok",
    "F_gap",
    "F_next"
  ],
  "properties": {
    "schema": {
      "const": "rafaelia.federation-state/v1"
    },
    "snapshot_id": {
      "type": "string",
      "minLength": 1
    },
    "observed_at": {
      "type": "string",
      "minLength": 1
    },
    "control_plane": {
      "const": "rafaelmeloreisnovo/Mapa"
    },
    "state": {
      "enum": [
        "VERIFICATION_PENDING",
        "FEDERATION_CERTIFIED"
      ]
    },
    "claim_allowed": {
      "type": "boolean"
    },
    "receipt_contract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repository",
        "pull_request",
        "head_commit",
        "path",
        "state"
      ],
      "properties": {
        "repository": {
          "type": "string",
          "minLength": 1
        },
        "pull_request": {
          "type": "integer",
          "minimum": 1
        },
        "head_commit": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "path": {
          "type": "string",
          "minLength": 1
        },
        "state": {
          "enum": [
            "PASS",
            "FAIL",
            "NOT_RUN",
            "PENDING",
            "AUDIT",
            "TOKEN_VAZIO",
            "IMPLEMENTED_UNTESTED",
            "OBSERVED_UNPROMOTED",
            "ROUTE_STATE_BLOCKED"
          ]
        }
      }
    },
    "nodes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "repository",
          "role",
          "head_commit",
          "head_observed_at",
          "state",
          "receipt_refs",
          "evidence_refs",
          "claim_allowed"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "repository": {
            "type": "string",
            "minLength": 1
          },
          "role": {
            "type": "string",
            "minLength": 1
          },
          "head_commit": {
            "type": "string",
            "pattern": "^[0-9a-f]{40}$"
          },
          "head_observed_at": {
            "type": "string",
            "minLength": 1
          },
          "state": {
            "enum": [
              "PASS",
              "FAIL",
              "NOT_RUN",
              "PENDING",
              "AUDIT",
              "TOKEN_VAZIO",
              "IMPLEMENTED_UNTESTED",
              "OBSERVED_UNPROMOTED",
              "ROUTE_STATE_BLOCKED"
            ]
          },
          "receipt_refs": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "evidence_refs": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "claim_allowed": {
            "type": "boolean"
          }
        }
      }
    },
    "gaps": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "gap_id",
          "state",
          "blocking",
          "detail"
        ],
        "properties": {
          "gap_id": {
            "type": "string",
            "minLength": 1
          },
          "state": {
            "enum": [
              "PASS",
              "FAIL",
              "NOT_RUN",
              "PENDING",
              "AUDIT",
              "TOKEN_VAZIO",
              "IMPLEMENTED_UNTESTED",
              "OBSERVED_UNPROMOTED",
              "ROUTE_STATE_BLOCKED"
            ]
          },
          "blocking": {
            "type": "boolean"
          },
          "detail": {
            "type": "string"
          }
        }
      }
    },
    "F_ok": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "F_gap": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "F_next": {
      "type": "string",
      "minLength": 1
    }
  }
}
