{
  "schema_version": "rafaelia.shared-data-criticality-policy/v1",
  "state": "CANONICAL_DRAFT",
  "private_by_default": true,
  "claim_allowed_certification": false,
  "drive_bridge_enabled": false,
  "levels": {
    "C0_PUBLIC": {
      "automatic_release": true,
      "requires_manifest": true,
      "requires_hash": true,
      "human_gate": false,
      "raw_bytes_to_actions": true
    },
    "C1_INTERNAL": {
      "automatic_release": false,
      "requires_manifest": true,
      "requires_hash": true,
      "human_gate": false,
      "raw_bytes_to_actions": true
    },
    "C2_SENSITIVE": {
      "automatic_release": false,
      "requires_manifest": true,
      "requires_hash": true,
      "human_gate": false,
      "requires_redaction": true,
      "requires_reidentification_assessment": true,
      "requires_semantic_cascade_assessment": true,
      "raw_bytes_to_actions": false
    },
    "C3_RESTRICTED": {
      "automatic_release": false,
      "requires_manifest": true,
      "requires_hash": true,
      "human_gate": true,
      "requires_redaction": true,
      "requires_reidentification_assessment": true,
      "requires_semantic_cascade_assessment": true,
      "raw_bytes_to_actions": false
    },
    "C4_CRITICAL": {
      "automatic_release": false,
      "requires_manifest": true,
      "requires_hash": true,
      "human_gate": true,
      "raw_bytes_to_actions": false,
      "automation_raw_export": "PROHIBITED"
    }
  },
  "stop_conditions": [
    "secret_or_credential_detected",
    "source_provenance_missing",
    "purpose_missing",
    "recipient_missing",
    "expired",
    "revoked",
    "criticality_C4_raw_bytes",
    "C2_plus_reidentification_TOKEN_VAZIO",
    "C2_plus_semantic_reconstruction_TOKEN_VAZIO",
    "C2_plus_redaction_not_passed"
  ]
}
