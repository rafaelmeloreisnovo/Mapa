    {"id": "SIMILAR_TO", "symmetric": true, "transitive": false, "evidence_required": "declared comparison dimensions"},
    {"id": "DEPENDS_ON", "symmetric": false, "transitive": "CONDITIONAL", "evidence_required": "dependency contract"},
    {"id": "IMPLEMENTS", "symmetric": false, "transitive": false, "evidence_required": "source and artifact binding"},
    {"id": "BUILDS", "symmetric": false, "transitive": false, "evidence_required": "build receipt"},
    {"id": "EXECUTES", "symmetric": false, "transitive": false, "evidence_required": "runtime receipt"},
    {"id": "TESTS", "symmetric": false, "transitive": false, "evidence_required": "test identity and outcome"},
    {"id": "FALSIFIES", "symmetric": false, "transitive": false, "evidence_required": "claim target and executed falsifier"},
    {"id": "SUPPORTS", "symmetric": false, "transitive": false, "evidence_required": "bounded evidence scope"},
    {"id": "CONTRADICTS", "symmetric": true, "transitive": false, "evidence_required": "lhs, rhs and shared scope"},
    {"id": "SUPERSEDES", "symmetric": false, "transitive": true, "evidence_required": "append-only transition receipt"},
    {"id": "PART_OF", "symmetric": false, "transitive": true, "evidence_required": "containment contract"},
    {"id": "PRODUCED_BY", "symmetric": false, "transitive": false, "evidence_required": "producer authority and receipt"},
    {"id": "AUTHORIZED_BY", "symmetric": false, "transitive": false, "evidence_required": "authority decision"},
    {"id": "ROLLS_BACK_TO", "symmetric": false, "transitive": false, "evidence_required": "known-good target and compatibility"},
    {"id": "FAILS_OVER_TO", "symmetric": false, "transitive": false, "evidence_required": "ordered target and failover receipt"},
    {"id": "BRIDGES_TRANSVERSELY", "symmetric": false, "transitive": false, "evidence_required": "explicit mapped dimensions"},
    {"id": "TOKEN_VAZIO_RELATION", "symmetric": false, "transitive": false, "evidence_required": "reason and next gate"}
