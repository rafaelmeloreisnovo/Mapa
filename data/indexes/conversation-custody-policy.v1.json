{
  "schema": "rafaelia.conversation-custody-policy.v1",
  "version": "1.0.0",
  "claim_allowed": false,
  "authority": {
    "source_bytes": "IMMUTABLE_RECONSTRUCTION_AUTHORITY",
    "google_drive": "PRIVATE_LONGITUDINAL_CUSTODY",
    "mapa": "ONTOLOGY_INDEX_AND_DECISION_LEDGER",
    "human_data_subject": "FINAL_PERSONAL_DATA_AUTHORITY"
  },
  "constitutional_precedence": [
    "C0_HUMAN_DIGNITY_AND_FUNDAMENTAL_RIGHTS",
    "C1_JURISDICTION_AND_DATA_PROTECTION",
    "C2_CULTURAL_LINGUISTIC_CONTEXT",
    "C3_PERSONAL_SOVEREIGN_FAROL",
    "C4_SERVICE_AND_BUSINESS_OBJECTIVE",
    "C5_MODEL_RETRIEVAL_AND_OUTPUT"
  ],
  "personal_states": [
    "DECLARED", "OBSERVED_WITH_CONSENT", "INFERRED_VISIBLE",
    "CONTESTED", "SENSITIVE", "EXPIRED", "TOKEN_VAZIO"
  ],
  "source_rules": {
    "read_only": true,
    "ordered_parts_required": true,
    "parse_only_after_complete_array_boundary": true,
    "full_source_sha256_required": true,
    "source_rewrite": false
  },
  "derived_index": {
    "raw_titles": false,
    "raw_message_bodies": false,
    "opaque_ids_default": false,
    "identifier_mode": "SHA256_PSEUDONYMIZED",
    "derived_segment_max_bytes": 8388608,
    "inference_capsule_max_utf8_bytes": 65536,
    "inference_capsule_overlap_bytes": 4096,
    "max_active_dimensions_human_surface": 5
  },
  "alpha_delta_omega": {
    "alpha": "DECLARED_INTENTION_AND_SOURCE_SCOPE",
    "delta": "APPEND_ONLY_TRANSFORMATION_WITH_RECEIPT",
    "omega": "INTEGRATED_WORK_STATE_WITH_F_OK_F_GAP_F_NEXT_NOT_FINAL_CLOSURE"
  },
  "bipolar_inquiry": {
    "support_branch": "STEELMAN_AND_SUPPORTING_EVIDENCE",
    "falsifier_branch": "STRONGEST_DISCONFIRMING_TEST",
    "null_branch": "ALTERNATIVE_OR_SIMPLER_EXPLANATION",
    "equal_initial_budget": true,
    "forced_equal_conclusion": false
  },
  "geometry": {
    "state": "MODELO_ANALOGICO_NAO_CALIBRADO",
    "allowed_uses": [
      "navigation", "semantic_distance_candidate", "depth_tiering", "graph_visualization"
    ],
    "blocked_promotions": [
      "POINCARE_AS_PROOF", "YANG_MILLS_AS_PROOF", "NAVIER_STOKES_AS_PROOF",
      "P_VS_NP_AS_PROOF", "THEOLOGY_AS_PHYSICAL_MECHANISM"
    ]
  },
  "privacy_controls": [
    "INSPECT", "CORRECT", "CONTEST", "REVOKE", "EXPORT", "DELETE_WHEN_APPLICABLE"
  ],
  "fail_closed_states": [
    "TOKEN_VAZIO_REASSEMBLY_REQUIRED",
    "TOKEN_VAZIO_SOURCE_PARSE_FAILED",
    "TOKEN_VAZIO_PRIVACY_REVIEW_PENDING",
    "TOKEN_VAZIO_HUMAN_REVIEW_PENDING"
  ],
  "automatic_publication": false,
  "automatic_merge": false
}
