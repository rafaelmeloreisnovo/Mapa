{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rafaelia.local/schemas/orchestrator/module_registry.schema.json",
  "title": "RAFAELIA Orchestrator Module Registry",
  "description": "Canonical registry for federated modules. Repository presence alone does not prove runtime capability.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "generated_at", "claim_allowed", "modules"],
  "properties": {
    "schema": {"const": "rafaelia.module-registry.v1"},
    "generated_at": {"type": "string", "format": "date-time"},
    "claim_allowed": {"const": false},
    "modules": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/module"}
    }
  },
  "$defs": {
    "nonEmptyString": {"type": "string", "minLength": 1},
    "tokenVazioOrString": {
      "oneOf": [
        {"type": "string", "minLength": 1, "not": {"const": "TOKEN_VAZIO"}},
        {"const": "TOKEN_VAZIO"}
      ]
    },
    "module": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "module_id",
        "name",
        "repository",
        "branch",
        "observed_ref",
        "plane",
        "role",
        "capabilities",
        "inputs",
        "outputs",
        "health_probe",
        "safe_state",
        "rollback",
        "cache_policy",
        "syslog_adapter",
        "privacy_classes",
        "state",
        "evidence_refs",
        "known_gaps",
        "next_action",
        "owner"
      ],
      "properties": {
        "module_id": {"type": "string", "pattern": "^MOD-[A-Z0-9][A-Z0-9_-]{2,127}$"},
        "name": {"$ref": "#/$defs/nonEmptyString"},
        "repository": {"type": "string", "pattern": "^[^/\\s]+/[^/\\s]+$"},
        "path": {"type": "string"},
        "branch": {"$ref": "#/$defs/nonEmptyString"},
        "observed_ref": {
          "oneOf": [
            {"type": "string", "pattern": "^[0-9a-f]{40}$"},
            {"type": "string", "pattern": "^TOKEN_VAZIO_[A-Z0-9_]+$"}
          ]
        },
        "plane": {
          "enum": [
            "intent",
            "control",
            "execution",
            "evidence",
            "virtualization",
            "virtualization-engine",
            "data-ingestion",
            "data-index",
            "memory",
            "governance-index",
            "observability"
          ]
        },
        "role": {"$ref": "#/$defs/nonEmptyString"},
        "capabilities": {
          "type": "array",
          "items": {"$ref": "#/$defs/capability"}
        },
        "product_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "pattern": "^PDT-[0-9]{2,4}$"}
        },
        "inputs": {"type": "array", "items": {"$ref": "#/$defs/nonEmptyString"}},
        "outputs": {"type": "array", "items": {"$ref": "#/$defs/nonEmptyString"}},
        "commands": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["command_id", "mode", "allowlisted"],
            "properties": {
              "command_id": {"$ref": "#/$defs/nonEmptyString"},
              "mode": {"enum": ["read_only", "mutating", "diagnostic", "build", "runtime"]},
              "allowlisted": {"type": "boolean"}
            }
          }
        },
        "read_only_default": {"type": "boolean", "default": true},
        "network_default": {"type": "boolean", "default": false},
        "health_probe": {"$ref": "#/$defs/tokenVazioOrString"},
        "safe_state": {"$ref": "#/$defs/nonEmptyString"},
        "rollback": {"$ref": "#/$defs/tokenVazioOrString"},
        "cache_policy": {
          "type": "object",
          "additionalProperties": false,
          "required": ["tier", "key_fields", "invalidation"],
          "properties": {
            "tier": {"enum": ["none", "C0", "C1", "C2", "C3", "C4", "C5"]},
            "key_fields": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/nonEmptyString"}},
            "invalidation": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/nonEmptyString"}}
          }
        },
        "syslog_adapter": {
          "type": "object",
          "additionalProperties": false,
          "required": ["human_log", "event_jsonl"],
          "properties": {
            "human_log": {"enum": ["implemented", "partial", "absent", "TOKEN_VAZIO"]},
            "event_jsonl": {"enum": ["implemented", "partial", "absent", "TOKEN_VAZIO"]}
          }
        },
        "privacy_classes": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"enum": ["public", "internal", "restricted", "secret"]}
        },
        "resource_profile": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "architectures": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/nonEmptyString"}},
            "max_memory_bytes": {"type": ["integer", "string"], "minimum": 1048576},
            "timeout_seconds": {"type": ["integer", "string"], "minimum": 1}
          }
        },
        "state": {
          "enum": [
            "DISCOVERED",
            "DECLARED",
            "CONTRACTED",
            "BUILDABLE",
            "TESTED_LOCAL",
            "TESTED_DEVICE",
            "INTEGRATED",
            "DEGRADED",
            "BLOCKED",
            "RETIRED",
            "PARTIAL",
            "TOKEN_VAZIO"
          ]
        },
        "evidence_refs": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/nonEmptyString"}},
        "known_gaps": {"type": "array", "items": {"$ref": "#/$defs/nonEmptyString"}},
        "next_action": {"$ref": "#/$defs/nonEmptyString"},
        "owner": {"$ref": "#/$defs/nonEmptyString"}
      }
    },
    "capability": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "state", "contract_id"],
      "properties": {
        "name": {"type": "string", "pattern": "^[a-z0-9]+(?:[._-][a-z0-9]+)*$"},
        "contract_id": {"type": "string", "pattern": "^CAP-[A-Z0-9_-]+$"},
        "state": {"enum": ["DECLARED", "CONTRACTED", "TESTED_LOCAL", "TESTED_DEVICE", "INTEGRATED", "TOKEN_VAZIO"]},
        "evidence_receipt_id": {"type": "string"},
        "abi_signature": {"type": "string", "description": "hash of ABI contract for change detection"}
      }
    }
  }
}
