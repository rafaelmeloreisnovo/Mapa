  "invariants": [
    {
      "id": "MSR-I01",
      "rule": "semantic_token != tokenizer_token_id",
      "falsifier": "A record silently uses a Mapa semantic token as a provider tokenizer ID."
    },
    {
      "id": "MSR-I02",
      "rule": "external_semantic_vector != native_model_embedding",
      "falsifier": "An edge promotes external rapport similarity to identity with a hidden model embedding."
    },
    {
      "id": "MSR-I03",
      "rule": "tensor != weight",
      "falsifier": "A record treats every runtime tensor as a trainable parameter."
    },
    {
      "id": "MSR-I04",
      "rule": "context_conditioning != parameter_training",
      "falsifier": "Context is asserted to update weights without an allowed update mode and execution evidence."
    },
    {
      "id": "MSR-I05",
      "rule": "llm_label != transformer_architecture_proof",
      "falsifier": "An unbound LLM label is used as sole evidence for a Transformer implementation."
    },
    {
      "id": "MSR-I06",
      "rule": "LNN requires explicit expansion",
      "falsifier": "LNN is consumed without selecting Liquid Time-constant or Logical Neural Network."
    },
    {
      "id": "MSR-I07",
      "rule": "proprietary_withheld != measured_local",
      "falsifier": "Hidden weights or activations are marked measured without an inspectable artifact and receipt."
    },
    {
      "id": "MSR-I08",
      "rule": "repository_license != weights_tokenizer_dataset_license",
