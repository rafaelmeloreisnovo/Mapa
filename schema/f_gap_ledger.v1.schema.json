{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rafaelia.local/schema/f_gap_ledger.v1.schema.json",
  "title": "RAFAELIA F_GAP Ledger v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "generated_at", "state", "claim_allowed", "invariant", "states", "priority_order", "summary", "gaps"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "generated_at": {"type": "string", "minLength": 1},
    "state": {"enum": ["GOVERNED_PARTIAL", "VERIFIED_LIMITED", "VERIFIED"]},
    "claim_allowed": {"type": "boolean"},
    "invariant": {"type": "string", "minLength": 1},
    "states": {"type": "array", "uniqueItems": true, "minItems": 6, "items": {"type": "string"}},
    "priority_order": {"const": ["P0", "P1", "P2"]},
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["total", "p0", "p1", "p2"],
      "properties": {
        "total": {"type": "integer", "minimum": 0},
        "p0": {"type": "integer", "minimum": 0},
        "p1": {"type": "integer", "minimum": 0},
        "p2": {"type": "integer", "minimum": 0}
      }
    },
    "gaps": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/gap"}
    }
  },
  "$defs": {
    "gap": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "priority", "domain", "state", "gap", "next"],
      "properties": {
        "id": {"type": "string", "pattern": "^FG-[0-9]{3}$"},
        "priority": {"enum": ["P0", "P1", "P2"]},
        "domain": {"type": "string", "minLength": 1},
        "state": {"enum": ["CONFIRMED_SOURCE", "IMPLEMENTED_UNVERIFIED", "UNCERTAINTY", "TOKEN_VAZIO", "BLOCKED_SAFETY", "CLOSED"]},
        "gap": {"type": "string", "minLength": 1},
        "next": {"type": "string", "minLength": 1},
        "evidence": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "provenance": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "acceptance_test": {"type": "string", "minLength": 1},
        "receipt": {"type": "string", "minLength": 1}
      },
      "allOf": [
        {
          "if": {"properties": {"state": {"const": "CLOSED"}}, "required": ["state"]},
          "then": {"required": ["evidence", "provenance", "acceptance_test", "receipt"]}
        }
      ]
    }
  }
}
